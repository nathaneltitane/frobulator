# prompt management tool (pmt) ─────────────────────────────────────────────────

# prompt management and standardizing to terminal width:
# adds line folding with word detection for strings wider than terminal

frobulator.pmt () {

	local begin
	local end
	local span
	local width_prompt
	local margin_left
	local length_margin_left
	local length_span
	local character_span
	local length_character_span
	local length_begin
	local length_end
	local character_end_open
	local character_end_close
	local length_marker_elp
	local index_bracket
	local segment_end_first
	local segment_end_last
	local segment_end_head
	local segment_end_tail
	local limit_span
	local limit_end
	local limit_segment_end_head
	local count_fold
	local count_span
	local span_begin
	local span_middle
	local span_end

	local -a list_brackets_open
	local -a list_brackets_close

	# initialize string return array

	prompt_string=()

	# define input arguments

	begin="${1}"
	end="${2}"

	# provide fallback for line character count

	if [ -z "${width_prompt}" ]
	then
		width_prompt="${columns_terminal}"
	fi

	# set span width

	if [ ${#begin} -le "${width_prompt}" ]
	then
		while [ ${#span} -lt "${width_prompt}" ]
		do
			span="${span}-"
		done
	else
		span="${span}"
	fi

	# prepare span for line marker usage:
	# [     ] ────────────────────────────────────────────────────────────...───

	margin_left="${marker_nul}${marker_spc}"
	length_margin_left=${#margin_left}

	length_span=${#span}

	if [ ${length_span} -le 0 ]
	then
		span=${span}
	else
		span=${span::-${length_margin_left}}
	fi

	# set span character default:
	# do not use '\' - reserved for BASH esacpe sequences

	character_span="─"

	# 3 arguments - replace span character with argument 3

	if [ $# -eq 3 ]
	then
		character_span="${3}"
		length_character_span=${#character_span}

		# if span character length greater than 2:
		# compensate by dividing to achieve 80 characters total span

		if [ ${length_character_span} -ge 2 ]
		then
			width_prompt=$(( ${width_prompt} / ${length_character_span} ))

			length_span=${width_prompt}
		fi
	fi

	length_span=${#span}

	# 2+ arguments:
	# append space to 'begin' value
	# prepend space to 'end' value

	if [ $# -ge 2 ]
	then
		begin="${begin}${marker_spc}"
		end="${marker_spc}${end}"

		length_begin=${#begin}
		length_end=${#end}

		character_end_open=${end:0:1}
		character_end_close=${end: -1:1}

		length_marker_elp=${#marker_elp}

		# adjust for longer than usual arguments:
		# truncate end with ellipsis

		# formatting -  utf bracket styling
		# preserve second argument brackets and padding when present

		list_brackets_open=(
			'['
			'('
			'{'
			'<'
			'«'
			'‹'
			'「'
			'『'
			'【'
			'〔'
			'〘'
			'〚'
			'⟨'
			'⟪'
			'⟮'
			'⦅'
			'⦃'
		)

		list_brackets_close=(
			']'
			')'
			'}'
			'>'
			'»'
			'›'
			'」'
			'』'
			'】'
			'〕'
			'〙'
			'〛'
			'⟩'
			'⟫'
			'⟯'
			'⦆'
			'⦄'
		)

		for index_bracket in "${!list_brackets_open[@]}"
		do
			if [ "${character_end_open}" = "${list_brackets_open[${index_bracket}]}"   ] ||
			   [ "${character_end_close}" = "${list_brackets_close[${index_bracket}]}" ]
			then
				# include last string digit for recognition

				segment_end_last=${end: -$length_marker_elp}

				break
			fi
		done

		# preserve span character at minimum of 2 characters

		limit_span=$(( 6 + 2 ))

		limit_end=$(( length_span - length_begin - limit_span ))

		if [ "${limit_end}" -gt 0 ] && [ "${length_end}" -gt "${limit_end}" ]
		then
			# keep hint tail intact: [ 'name' // value ] truncates the name only
			# closing quote of the name stays with the tail

			unset segment_end_tail

			if [[ "${end}" == *"${marker_spc}${marker_hnt}${marker_spc}"* ]]
			then
				segment_end_tail="${marker_spc}${marker_hnt}${marker_spc}${end##*${marker_spc}${marker_hnt}${marker_spc}}"
				segment_end_head="${end%${segment_end_tail}}"

				if [[ "${segment_end_head: -1:1}" = [\'\"] ]]
				then
					segment_end_tail="${segment_end_head: -1:1}${segment_end_tail}"
					segment_end_head="${segment_end_head:0:-1}"
				fi

				limit_segment_end_head=$(( limit_end + ${#segment_end_last} - ${#segment_end_tail} ))
			fi

			if [ -n "${segment_end_tail}" ] && [ "${limit_segment_end_head}" -gt 4 ]
			then
				if [ "${#segment_end_head}" -gt "${limit_segment_end_head}" ]
				then
					end="${segment_end_head:0:${limit_segment_end_head}}${marker_elp}${segment_end_tail}"
				fi
			else
				segment_end_first=${end:0:${limit_end}}

				# append ellipsis marker to end of truncation

				end="${segment_end_first}${marker_elp}${segment_end_last}"
			fi
		fi

	fi

	# define parsing calculation lengths

	length_begin=${#begin}
	length_end=${#end}

	# 74+ characters per string:
	# fold string using word detection at limit
	# prevent overstepping 80 characters overall limit
	# indent second line onward (6 spaces) to match line marker (margin_left)
	# detect newline character and indent onward to match line marker spacing

	count_fold=$(( "${width_prompt}" - "${length_margin_left}" ))

	if [ "${length_begin}" -ge "${count_fold}" ]
	then
		begin=$(
				echo "${begin}"										|
					fold -s -w "${count_fold}"						|
					sed 											\
						-e '2,$'"s/^/${marker_idt}${marker_spc}/g"	|
					sed 											\
						-e 's/ \\n /\\n\n      /g'
		)
	fi

	# substitute span character

	span="${span//-/$character_span}"

	# print first argument:
	# remove newline for continuous string arguments

	span_begin=$(echo -n -e "${begin}")

	# print other arguments as fixed width prompt if present:
	# calculate span width - remove 6 characters for prompt header

	count_span=$(( length_span - length_begin - length_end ))

	if [ "${count_span}" -lt 0 ]
	then
		count_span=0
	fi

	# set new padding width

 	if [ ${length_begin} -lt "${width_prompt}" ]
 	then
 		span=${span:0:$count_span}
 	else
 		span=""
 	fi

 	# define user input aor automatic fill

	span_middle="${span}"

	# print last argument:
	# carry newline and jump to next block

	span_end=$(echo -e "${end}")

	# populate array at end to avoid integrating spaces

	if [ $# -ge 0 ]
	then
		prompt_string=("${span_begin}""${span_middle}""${span_end}")
	fi

	if [ $# -eq 1 ]
	then
		prompt_string=("${span_begin}")
	fi

	if [ $# -ge 2 ]
	then
		prompt_string=("${span_begin}""${span_middle}""${span_end}")
	fi

	if [ $# -eq 3 ]
	then
		prompt_string=("${span_begin}""${span_middle}""${span_end}")
	fi

}

# line break ───────────────────────────────────────────────────────────────────

# use to separate line markers with a blank line
# carry-over markers (nul / ind) rejoin the line above instead

# usage:      frobulator.brk [rows]

frobulator.brk () {

	local rows_line="${1}"

	local length_line

	# rows of the marker line above - wrapped at real terminal width - given by multi-line callers

	if [ -z "${rows_line}" ]
	then
		length_line=$(( ${#marker_nul} + ${#marker_spc} + ${#prompt} ))
		rows_line=$(( ( length_line + columns_terminal_actual - 1 ) / columns_terminal_actual ))
	fi

	echo

	spaced_marker="true"
	lines_printed_terminal=$(( lines_printed_terminal + rows_line + 1 ))
}

# palette ──────────────────────────────────────────────────────────────────────

# use to add a named color to the palette at run time:
# accepted wherever a palette color name is - num - sep - critter
# terminal output only - empty otherwise - as the built in colors

# usage:      frobulator.palette "[name]" "[color code 0 to 255]"

frobulator.palette () {

	local status=0
	local name_color="${1}"
	local value_color="${2}"

	if [[ ! "${name_color}" =~ ^[a-z][a-z_]*$ ]] || [[ ! "${value_color}" =~ ^[0-9]{1,3}$ ]] || [ "${value_color}" -gt 255 ]
	then
		frobulator.err "Invalid palette color" "[ ${name_color} // ${value_color} ]"

		return 1
	fi

	# palette entry - name recognised by the color options

	if [[ ! "$(printf ' %s ' "${colors_selection[@]%%=*}")" == *" ${name_color} "* ]]
	then
		colors_selection+=("${name_color}=${value_color}")
	fi

	# color sequence - tput or ansi - empty without a terminal

	if [[ -t 1 ]] && [ -n "$(command -v tput)" ]
	then
		printf -v "${name_color}" '%s' "$(tput setaf "${value_color}")"

	elif [[ -t 1 ]]
	then
		printf -v "${name_color}" '\e[38;5;%sm' "${value_color}"
	else
		printf -v "${name_color}" '%s' ""
	fi

	return "${status}"
}

