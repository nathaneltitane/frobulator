# purge ────────────────────────────────────────────────────────────────────────

# use to purge package(s) from argument or array list

# usage:      frobulator.purge "[package]" | "[array]"

frobulator.purge () {

	local status=0
	local command_purge="apt-get --assume-yes purge --autoremove"

	local installed_package
	local package

	export DEBIAN_FRONTEND=noninteractive

	if [[ "${#list[@]}" -gt 0 ]]
	then
		# ${1} - array

		list=("${@:1}")
	else
		package="${1}"

		list=()

		list+=("${package}")
	fi

	frobulator.inf "Purging selected package(s)"

	for package in "${list[@]}"
	do
		# 'installed' if apt lists the package as installed - empty otherwise

		installed_package="$(apt search "${package}" 2> "${sink}" | grep -i -o installed)"

		if [ -n "${installed_package}" ]
		then
			frobulator.wrn "Selecting" "[ '${package}' ]"

			frobulator.log "${command_purge} ${package}" &

			frobulator.progress "purge"

			frobulator.track
		else
			frobulator.scs "Absent on system" "[ '${package}' ]"

			frobulator.fwd "Continuing${marker_elp}"
		fi
	done

	# unset array

	list=()

	return "${status}"

}

# dialog ───────────────────────────────────────────────────────────────────────

# use to generate standard dialogs using desktop environement plugins:

# supports:
#              gnome - zenity
#              kde   - kdialog

frobulator.dialog () {

	local status=0
	local title="${script%.sh} - ${1}"

	local command_zenity
	local command_kdialog
	local selection_dialog

	local -a command_dialog=("${@:2}")

	# file dialog tools - empty if absent: gnome zenity / kde kdialog

	command_zenity="$(command -v zenity)"
	command_kdialog="$(command -v kdialog)"

	if [ -n "${command_zenity}" ]
	then
		selection_dialog="$(
			zenity						\
				--file-selection		\
				--multiple				\
				--directory				\
				--separator=$'\n'		\
				--title="${title}"		\
				"${command_dialog[@]}"
		)"

		status="${?}"

	elif [ -n "${command_kdialog}" ]
	then
		selection_dialog="$(
			kdialog								\
				--getexistingdirectory			\
				--title "${title}"				\
				"${command_dialog[@]}"
		)"

		status="${?}"
	else
		frobulator.wrn "This utility must be run using the 'directory' option"

		frobulator.fwd "Exiting${marker_elp}"

		return 1
	fi

	# selection printed - one path per line

	if [ -n "${selection_dialog}" ]
	then
		echo "${selection_dialog}"
	fi

	return "${status}"

}

# exit ─────────────────────────────────────────────────────────────────────────

# use to cleanly exit the current script or process instance
# does not terminate the shell - see frobulator.close for that behavior

# usage:      frobulator.exit "[instance]" "[exit code]"

frobulator.exit () {

	local status="${2:-0}"
	local instance="${1}"

	frobulator.countdown 3 "Exiting" "[ ${instance} ]"

	frobulator.track

	exit "${status}"
}

# terminate ────────────────────────────────────────────────────────────────────

# use to forcefully terminate rogue processes

# usage:      frobulator.terminate "[process]"

frobulator.terminate () {

	local status=0
	local name_process="${1}"

	local command_pgrep
	local command_pkill
	local ids_process

	if [ -z "${name_process}" ]
	then
		frobulator.err "No process specified"

		return 1
	fi

	# process tools - empty if absent

	command_pgrep="$(command -v pgrep)"
	command_pkill="$(command -v pkill)"

	if [ -z "${command_pgrep}" ]
	then
		frobulator.err "Command not available" "[ 'pgrep' ]"

		return 1
	fi

	if [ -z "${command_pkill}" ]
	then
		frobulator.err "Command not available" "[ 'pkill' ]"

		return 1
	fi

	# process ids still matching the name - empty once all are gone

	ids_process="$(pgrep -f "${name_process}")"

	while [ -n "${ids_process}" ]
	do
		pkill -f "${name_process}"

		frobulator.track || break

		ids_process="$(pgrep -f "${name_process}")"
	done

	return "${status}"

}

# close ────────────────────────────────────────────────────────────────────────

# use to close the current shell session

# usage:      frobulator.close "[instance]"

frobulator.close () {

	local status=0
	local instance="${1}"

	frobulator.countdown 3 "Exiting" "[ ${instance} ]"

	frobulator.track

	frobulator.terminate "${SHELL}"

	frobulator.track

	return "${status}"
}

# user ─────────────────────────────────────────────────────────────────────────

# use to identify 'user' name
# useful for priviledged execution status checks

# usage:      frobulator.user

frobulator.user () {

	local status=0
	local seconds="1"

	frobulator.msg "Active shell user" "[ '${SUDO_USER:-${USER}}' ]"

	sleep "${seconds}"

	frobulator.track

	return "${status}"

}

# assess ───────────────────────────────────────────────────────────────────────

# use to assess 'superuser' status and prompt for priviledged execution
# useful for in-script dependency assessment and installation

# usage:      frobulator.assess "[package]" | "[array]"

frobulator.assess () {

	local status=0

	local command_path
	local command
	local reply
	local user_current
	local status_package

	if [[ "${#list[@]}" -gt 0 ]]
	then
		# ${1} - array

		list=("${@:1}")
	else
		command="${1}"

		list=()

		list+=("${command}")
	fi

	user_current="$(id -u -n)"

	if [ "${?}" -ne 0 ]
	then
		list=()

		return 1
	fi

	if [ "${user_current}" = "root" ]
	then
		frobulator.require "${list[@]}"

		if [ "${?}" -ne 0 ]
		then
			status=1
		else
			frobulator.msg "Requirement(s) installed" "[ ${script} ]"

			frobulator.inf "Restart as '${USER}' to proceed" "[ '${script}' ]"
		fi
	else
		for command in "${list[@]}"
		do
			# command path - empty if not installed

			command_path="$(command -v "${command}")"

			# package install state - empty if unknown to dpkg - covers packages without a command

			status_package="$(dpkg-query --show --showformat='${Status}' "${command}" 2> "${sink}")"

			if [ -z "${command_path}" ] && [[ "${status_package}" != *"ok installed"* ]]
			then
				frobulator.err "Missing" "[ '${command}' ]"

				frobulator.wrn "Privilege escalation required to proceed" "[ '${script}' ]"

				frobulator.qst "Launch as 'root'?"

				read -r reply
				echo

				# question line with answer + blank line

				lines_printed_terminal=$(( lines_printed_terminal + 2 ))

				if [[ "${reply}" = [yY] ]] || [[ "${reply}" = [yY][eE][sS] ]]
				then
					frobulator.escalate

					frobulator.track
				else
					frobulator.wrn "Launch as 'root' to install requirement(s)" "[ '${script}' ]"

					status=1
				fi
			fi
		done
	fi

	# unset array

	list=()

	return "${status}"

}

# escalate ─────────────────────────────────────────────────────────────────────

# use to provide priviledged command or script execution
# restarts process as 'superuser' once status is granted

# scans the calling script's own content for known root-requiring patterns
# (package installs, user/group management, writes to system paths) and
# only escalates when one is found - otherwise proceeds as the current user

# never escalates an interactive shell (tty startup: bashrc, bash_profile,
# bash_login, etc.), regardless of pattern matching

# usage:      self_arguments=("${@}")
#             frobulator.escalate

frobulator.escalate () {

	local status=0
	local self="${0}"
	local required_root=false
	local count_lines_header=3
	local count_erase=$(( count_lines_header + 1 ))

	local declaration_self_arguments
	local command_sudo
	local status_sudo_credentials
	local count_erase_first
	local user_current
	local pattern_root

	local -a list_self_arguments=()
	local -a list_patterns_root=(

		'frobulator\.(require|install|reinstall|purge|hold|release|failsafe|clean|update|upgrade)'
		'apt-get[[:space:]]+(install|remove|purge)'
		'apt[[:space:]]+(install|remove|purge)'
		'dnf[[:space:]]+install'
		'yum[[:space:]]+install'
		'pacman[[:space:]]+(-S|--sync)'
		'apk[[:space:]]+add'
		'zypper[[:space:]]+install'
		'useradd|usermod|userdel|groupadd|groupdel'
		"(^|[[:space:]\"'=:(])/(etc|usr|opt|boot|lib|lib64|srv|root)/"
		"(^|[[:space:]\"'=:(])/var/(lib|cache|spool|log)/"
	)

	# join patterns

	local IFS='|'
	local status_scan
	pattern_root="${list_patterns_root[*]}"
	IFS=$' \t\n'

	# restore script arguments

	# how the bootstrap stored the arguments: 'declare -a ...' for an array - older headers use a string

	declaration_self_arguments="$(declare -p self_arguments 2> "${sink}")"

	if [[ "${declaration_self_arguments}" == "declare -a"* ]]
	then
		list_self_arguments=("${self_arguments[@]}")
	else
		read -r -a list_self_arguments <<< "${self_arguments}"
	fi

	user_current="$(id -u -n)"

	frobulator.track || return 1

	if [ "${user_current}" = "root" ]
	then
		# clear restarted header and sudo password prompt - count passed by the user run

		if [ -n "${lines_erase_escalation}" ]
		then
			frobulator.erase "${lines_erase_escalation}"

			# header blank line - erased with the header

			echo

			unset lines_erase_escalation
		fi

		frobulator.fwd "Privilege escalation validated" "[ user${marker_spc}${marker_hnt}${marker_spc}'${user_current}' ]"

		if [ -n "${SUDO_USER}" ]
		then
			USER="${SUDO_USER}"
			HOME="/home/${SUDO_USER}"
		else
			USER="root"
			HOME="/root"
		fi

		return "${status}"
	fi

	# never escalate an interactive shell - hard rule, independent of pattern matching
	# tty startup: bashrc, bash_profile, bash_login, etc.

	# a sourced dotfile's own '${0}' may resolve to a readable binary e.g. '/bin/bash'
	# whose embedded strings could otherwise falsely match

	if [[ $- == *i* ]]
	then
		frobulator.inf "Privilege escalation prevented - interactive shell" "[ file${marker_spc}${marker_hnt}${marker_spc}'${self}' ]"

		return "${status}"
	fi

	# scan script body for root patterns

	escalate_scan () {

		local file="${1}"
		local open_list=false
		local count_entries=0
		local pattern_marker='^# version [/─]+$'
		local pattern_comment='^[[:space:]]*#'
		local pattern_list_open='^[[:space:]]*list=\('
		local pattern_list_close='^[[:space:]]*\)'
		local pattern_content='[^[:space:]]'
		local pattern_require='frobulator\.require[[:space:]]+"?\$\{list\[@\]\}"?[[:space:]]*$'

		local line
		local rest
		local index

		local -a lines=()

		mapfile -t lines < "${file}"

		# skip bootstrap header

		for (( index = 0 ; index < ${#lines[@]} ; index ++ ))
		do
			if [[ "${lines[index]}" =~ ${pattern_marker} ]]
			then
				break
			fi
		done

		if [ "${index}" -eq "${#lines[@]}" ]
		then
			index=0
		fi

		for line in "${lines[@]:index}"
		do
			# skip comments

			if [[ "${line}" =~ ${pattern_comment} ]]
			then
				continue
			fi

			# count requirement entries

			if [ "${open_list}" = true ]
			then
				if [[ "${line}" =~ ${pattern_list_close} ]]
				then
					open_list=false

				elif [[ "${line}" =~ ${pattern_content} ]]
				then
					count_entries=$(( count_entries + 1 ))
				fi

			elif [[ "${line}" =~ ${pattern_list_open} ]]
			then
				rest="${line#*list=(}"

				count_entries=0

				if [[ "${rest}" == *')'* ]]
				then
					rest="${rest%%)*}"
				else
					open_list=true
				fi

				if [[ "${rest}" =~ ${pattern_content} ]]
				then
					count_entries=$(( count_entries + 1 ))
				fi

			# skip empty requirements

			elif [[ "${line}" =~ ${pattern_require} ]] && [ "${count_entries}" -eq 0 ]
			then
				continue
			fi

			if [[ "${line}" =~ ${pattern_root} ]]
			then
				return 0
			fi
		done

		return 1
	}

	# determine whether the calling script actually requires root

	if [ -r "${self}" ]
	then
		escalate_scan "${self}"

		status_scan="${?}"

		if [ "${status_scan}" -eq 0 ]
		then
			required_root=true
		fi
	fi

	if [ "${required_root}" = false ]
	then
		frobulator.inf "Privilege escalation not required" "[ user${marker_spc}${marker_hnt}${marker_spc}'${user_current}' ]"

		return "${status}"
	fi

	frobulator.inf "Privilege escalation required" "[ user${marker_spc}${marker_hnt}${marker_spc}'${user_current}' ]"

	frobulator.wrn "Privilege escalation granted" "[ user${marker_spc}${marker_hnt}${marker_spc}'${SUDO_USER:-${USER}}' ]"

	frobulator.fwd "Privilege escalation restarting" "[ script${marker_spc}${marker_hnt}${marker_spc}'${self}' ]"

	# clear bootstrap and escalation messages - restarted script prints its own header

	count_erase_first=$(( count_lines_header + lines_printed_terminal ))

	frobulator.erase "${count_erase_first}"

	frobulator.timeout

	# privilege escalation tool - empty if absent

	command_sudo="$(command -v sudo)"

	if [ -z "${command_sudo}" ]
	then
		frobulator.require sudo

		frobulator.track || return 1
	fi

	# restarted header + sudo password prompt - no prompt line if credentials cached

	sudo -n true 2> "${sink}"
	status_sudo_credentials="${?}"

	if [ "${status_sudo_credentials}" -eq 0 ]
	then
		count_erase="${count_lines_header}"
	fi

	# set superuser password prompt

	export SUDO_PROMPT="[${marker_spc}$(tput setaf 3)${USER}$(tput sgr 0)${marker_spc}]${marker_spc}>_${marker_spc}?${marker_spc}"

	# restart as superuser with user home

	exec sudo env HOME="${HOME}" lines_erase_escalation="${count_erase}" "${SHELL}" "${self}" "${list_self_arguments[@]}"

	frobulator.track

	return "${status}"

}

# service ──────────────────────────────────────────────────────────────────────

# use to manage a systemd service, scoping automatically to '--user' or
# system context depending on whether the runtime is escalated

# a single argument is treated as a daemon-level action with no target unit
# two arguments target a specific service with the given action
# forwarded to systemctl

# 'activate' runs a full enable/start cycle with status verification

# 'reload' is the only action not requiring a service

# actions:    reload, status, activate, enable, disable, start, stop, restart

# usage:      frobulator.service "[action]"
#             frobulator.service "[action]" "[service]"

frobulator.service () {

	local status=0

	local id_user
	local line_service_running
	local line_service_inactive
	local service
	local action
	local action_service

	local -a scope_system_control=()
	local -a list_actions_service=()

	if [ "${#}" -eq 1 ]
	then
		action="${1}"
	fi

	if [ "${#}" -eq 2 ]
	then
		action="${1}"
		service="${2}"

	fi

	if [ -z "${action}" ]
	then
		frobulator.err "No action specified"

		return 1
	fi

	# running user id - 0 is root

	id_user="$(id -u)"

	if [ "${id_user}" -ne 0 ]
	then
		scope_system_control=(--user)
	fi

	if [ "${action}" = "reload" ]
	then
		if [ -z "${service}" ]
		then
			systemctl "${scope_system_control[@]}" daemon-reload > "${sink}" 2>&1 &

			frobulator.process "Reloading"
		else
			systemctl "${scope_system_control[@]}" reload "${service}" > "${sink}" 2>&1 &

			frobulator.process "Service reload" "[ ${service} ]"
		fi

		frobulator.track
	fi

	if [ "${action}" = "status" ]
	then
		if [ -z "${service}" ]
		then
			frobulator.err "No service specified"

			return 1
		fi

		# status line if the service is running - empty otherwise

		line_service_running="$(systemctl "${scope_system_control[@]}" status "${service}" | grep -e "active.*running")"

		if [ -n "${line_service_running}" ]
		then
			frobulator.scs "Service active" "[ ${service} ]"
		else
			frobulator.err "Service inactive" "[ ${service} ]"

			status=1
		fi
	fi

	if [ "${action}" = "activate" ]
	then
		if [ -z "${service}" ]
		then
			frobulator.err "No service specified"

			return 1
		fi

		systemctl "${scope_system_control[@]}" daemon-reload

		# status line if the service is running - empty otherwise

		line_service_running="$(systemctl "${scope_system_control[@]}" status "${service}" | grep -e "active.*running")"

		if [ -n "${line_service_running}" ]
		then
			frobulator.wrn "Service running" " [ ${service} ]"

			list_actions_service=(
				disable
				stop
			)
		fi

		list_actions_service+=(
			enable
			start
		)

		for action_service in "${list_actions_service[@]}"
		do
			systemctl "${scope_system_control[@]}" "${action_service}" "${service}" > "${sink}" 2>&1 &

			frobulator.process "Service ${action_service}" "[ ${service} ]"

			sleep 1

			systemctl "${scope_system_control[@]}" daemon-reload > "${sink}" 2>&1 &

			frobulator.process "Reloading"

			sleep 1
		done

		list_actions_service=()

		# status lines if the service is running or inactive - empty otherwise

		line_service_running="$(systemctl "${scope_system_control[@]}" status "${service}" | grep -e "active.*running")"
		line_service_inactive="$(systemctl "${scope_system_control[@]}" status "${service}" | grep -e "inactive.*")"

		if [ -n "${line_service_running}" ]
		then
			frobulator.scs "Service activation success" "[ ${service} ]"
		elif [ -n "${line_service_inactive}" ]
		then
			frobulator.err "Service activation failed" "[ ${service} ]"

			status=1
		fi
	fi

	if [ "${action}" = "enable" ] || [ "${action}" = "disable" ] || [ "${action}" = "start" ] || [ "${action}" = "stop" ] || [ "${action}" = "restart" ]
	then
		if [ -z "${service}" ]
		then
			frobulator.err "No service specified"

			return 1
		fi

		systemctl "${scope_system_control[@]}" "${action}" "${service}" > "${sink}" 2>&1 &

		frobulator.process "Service ${action}" "[ ${service} ]"

		frobulator.track
	fi

	if 	[ "${action}" != "reload"   ] &&
		[ "${action}" != "status"   ] &&
		[ "${action}" != "activate" ] &&
		[ "${action}" != "enable"   ] &&
		[ "${action}" != "disable"  ] &&
		[ "${action}" != "start"    ] &&
		[ "${action}" != "stop"     ] &&
		[ "${action}" != "restart"  ]
	then
		frobulator.err "Unknown action" "[ ${action} ]"

		status=1
	fi

	return "${status}"

}

# archive ──────────────────────────────────────────────────────────────────────

# use to archive content and for backup procedures

# "${directory}" defaults to "${PWD}" when omitted

# usage:      frobulator.archive "[archive]" "[type]" "[directory]"

frobulator.archive () {

	local status=0
	local file="${1}"
	local extension="${2}"
	local directory="${3:-${PWD}}"

	local archive
	local dependency

	if [ -z "${file}" ]
	then
		frobulator.err "No archive name specified"

		return 1
	fi

	if [ -z "${extension}" ]
	then
		frobulator.err "No archive type specified"

		return 1
	fi

	if [ ! -d "${directory}" ]
	then
		frobulator.err "Unavailable" "[ '${directory}' ]"

		return 1
	fi

	archive="${file}.${extension}"

	if [ "${extension}" = "tar.bz2" ] ||
	   [ "${extension}" = "tbz2"    ]
	then
		dependency="tar"

	elif [ "${extension}" = "tar.gz" ] ||
	     [ "${extension}" = "tgz"    ]
	then
		dependency="tar"

	elif [ "${extension}" = "tar" ]
	then
		dependency="tar"

	elif [ "${extension}" = "7z" ]
	then
		dependency="7z"

	elif [ "${extension}" = "rar" ]
	then
		dependency="rar"

	elif [ "${extension}" = "zip" ]
	then
		dependency="zip"
	else
		frobulator.err "Unsupported archive type" "[ '${archive}' ]"

		return 1
	fi

	frobulator.require "${dependency}"

	frobulator.track || return 1

	frobulator.inf "Archiving" "[ ${archive} ]"

	if [ "${extension}" = "tar.bz2" ] || [ "${extension}" = "tbz2" ]
	then
		tar												\
			--create									\
			--bzip2										\
			--file="${archive}"							\
			--directory="$(dirname "${directory}")"		\
			"$(basename "${directory}")"				> "${sink}" 2>&1

		frobulator.track

	elif [ "${extension}" = "tar.gz" ] || [ "${extension}" = "tgz" ]
	then
		tar												\
			--create									\
			--gzip										\
			--file="${archive}"							\
			--directory="$(dirname "${directory}")"		\
			"$(basename "${directory}")"				> "${sink}" 2>&1

		frobulator.track

	elif [ "${extension}" = "tar" ]
	then
		tar												\
			--create									\
			--file="${archive}"							\
			--directory="$(dirname "${directory}")"		\
			"$(basename "${directory}")"				> "${sink}" 2>&1

		frobulator.track

	elif [ "${extension}" = "7z" ]
	then
		7z												\
			a											\
			"${archive}"								\
			"${directory}"								> "${sink}" 2>&1

		frobulator.track

	elif [ "${extension}" = "rar" ]
	then
		rar												\
			a											\
			"${archive}"								\
			"${directory}"								> "${sink}" 2>&1

		frobulator.track

	elif [ "${extension}" = "zip" ]
	then
		zip												\
			--quiet										\
			--recurse-paths								\
			"${archive}"								\
			"${directory}"								> "${sink}" 2>&1

		frobulator.track
	fi

	if [ "${status}" -ne 0 ]
	then
		frobulator.err "Archive creation failed" "[ '${archive}' ]"
	else
		frobulator.scs "Archive created" "[ '${archive}' ]"
	fi

	return "${status}"

}

# extract ──────────────────────────────────────────────────────────────────────

# use to extract known archive types for script dependency or process resolution

# "${directory}" defaults to "${PWD}" when omitted

# "${extension}" is everything after the first period of the file name

# usage:      frobulator.extract "[archive]" "[directory]"

frobulator.extract () {

	local status=0
	local file="${1}"
	local directory="${2:-${PWD}}"

	local archive
	local extension
	local dependency

	if [ -z "${file}" ]
	then
		frobulator.err "No archive specified"

		return 1
	fi

	if [ ! -f "${file}" ]
	then
		frobulator.err "Unavailable" "[ '${file}' ]"

		return 1
	fi

	archive="${file##*/}"
	extension="${archive#*.}"

	if [ ! -d "${directory}" ]
	then
		mkdir				\
			--parents		\
							"${directory}"

		frobulator.fail "Unable to create directory" "[ '${directory}' ]" || return
	fi

	if [ "${extension}" = "tar.bz2" ] ||
	   [ "${extension}" = "tbz2"    ]
	then
		dependency="tar"

	elif [ "${extension}" = "tar.gz" ] ||
	     [ "${extension}" = "tgz"    ]
	then
		dependency="tar"

	elif [ "${extension}" = "tar" ]
	then
		dependency="tar"

	elif [ "${extension}" = "7z" ]
	then
		dependency="7z"

	elif [ "${extension}" = "rar" ]
	then
		dependency="unrar"

	elif [ "${extension}" = "zip" ]
	then
		dependency="unzip"
	else
		frobulator.err "Unsupported archive type" "[ '${archive}' ]"

		return 1
	fi

	frobulator.require "${dependency}"

	frobulator.track || return 1

	frobulator.inf "Extracting" "[ ${archive} ]"

	if [ "${extension}" = "tar.bz2" ] || [ "${extension}" = "tbz2" ]
	then
		tar									\
			--extract						\
			--no-same-owner					\
			--bzip2							\
			--file="${file}"				\
			--directory="${directory}"

	elif [ "${extension}" = "tar.gz" ] || [ "${extension}" = "tgz" ]
	then
		tar									\
			--extract						\
			--no-same-owner					\
			--gzip							\
			--file="${file}"				\
			--directory="${directory}"

	elif [ "${extension}" = "tar" ]
	then
		tar									\
			--extract						\
			--no-same-owner					\
			--file="${file}"				\
			--directory="${directory}"

	elif [ "${extension}" = "7z" ]
	then
		7z									\
			x								\
			"${file}"						\
			-o"${directory}"

	elif [ "${extension}" = "rar" ]
	then
		unrar								\
			e								\
			"${file}"						\
			"${directory}"

	elif [ "${extension}" = "zip" ]
	then
		# unzip has short options only: overwrite / quiet / target directory

		unzip								\
			-o								\
			-q								\
			"${file}"						\
			-d "${directory}"
	fi

	frobulator.track

	if [ "${status}" -ne 0 ]
	then
		frobulator.err "Archive extraction failed" "[ '${archive}' ]"
	else
		frobulator.scs "Archive extracted" "[ '${archive}' ]"
	fi

	return "${status}"
}

# critter ──────────────────────────────────────────────────────────────────────

# use to play a little critter animation - one cycle or looped until ctrl+c
# arguments in any order - animation / mouth / palette color / loop
# mouth adds talking to any animation - talk is the mouth on its own

# usage:      frobulator.critter [ walk | blink | antennae | expression | talk ] [mouth] [color] [loop]

frobulator.critter () {

	local status=0
	local animation="walk"
	local motion_mouth=false
	local loop_critter=false
	local name_color="orange"
	local delay_frame=15
	local height_frame=7
	local distance_walk=30
	local frame_mouth=0

	local argument
	local color_body
	local color_reset
	local entry
	local offset
	local state_antenna
	local state_eyes
	local state_legs
	local state_step
	local duration
	local seconds
	local count_chunk
	local index_chunk
	local shape_mouth
	local padding
	local line
	local step

	local -a timeline=()
	local -a lines_frame=()
	local -a pattern_mouth=(1 2 1 0 1 2 2 1 0 1 2 1 0 0 0 0 0)

	local -a shapes_mouth=(
		' ██████████████'
		' ██████▀▀██████'
		' ██████  ██████'
	)

	local -A shapes_antenna=(
		[up]='  ▀█▄      ▄█▀'
		[wiggle]='  ▄█▀      ▀█▄'
	)

	local -A shapes_eyes=(
		[open]=' ███ ██████ ███'
		[shut]=' ███▄██████▄███'
	)

	local -A shapes_legs=(
		[stand]='   █ █    █ █'
		[left]='  █ █    █ █'
		[right]='    █ █    █ █'
	)

	for argument in "${@}"
	do
		case "${argument}"
		in
			walk|blink|antennae|expression|talk)
				animation="${argument}"
			;;

			mouth)
				motion_mouth=true
			;;

			loop)
				loop_critter=true
			;;

			*)
				# palette color - added colors included

				if [[ "$(printf ' %s ' "${colors_selection[@]%%=*}")" == *" ${argument} "* ]]
				then
					name_color="${argument}"

					continue
				fi

				frobulator.err "Unknown critter argument" "[ ${argument} ]"

				status=1

				return "${status}"
			;;
		esac
	done

	# palette color - terminal output only

	if [ -t 1 ]
	then
		color_body="${!name_color}"
		color_reset="${reset}"
	fi

	# timeline - offset / antenna / eyes / legs / centiseconds

	case "${animation}"
	in
		walk)
			# right then back - legs alternate - blink and wiggle halfway each way

			for (( step = 0 ; step <= distance_walk * 2 ; step ++ ))
			do
				offset=$(( step <= distance_walk ? step : distance_walk * 2 - step ))

				if [ $(( step % 2 )) -eq 0 ]
				then
					state_step="left"
				else
					state_step="right"
				fi

				timeline+=("${offset} up open ${state_step} 15")

				if [ "${step}" -eq $(( distance_walk / 2 )) ] || [ "${step}" -eq $(( distance_walk * 3 / 2 )) ]
				then
					timeline+=(
						"${offset} up shut stand 15"
						"${offset} up open stand 15"
						"${offset} wiggle open stand 15"
						"${offset} up open stand 15"
						"${offset} wiggle open stand 15"
						"${offset} up open stand 15"
					)
				fi
			done
		;;

		blink)
			timeline=(
				"0 up open stand 200"
				"0 up shut stand 15"
				"0 up open stand 150"
				"0 up shut stand 15"
				"0 up open stand 20"
				"0 up shut stand 15"
				"0 up open stand 15"
			)
		;;

		antennae)
			timeline=(
				"0 up open stand 150"
				"0 wiggle open stand 20"
				"0 up open stand 20"
				"0 wiggle open stand 20"
				"0 up open stand 20"
			)
		;;

		expression)
			timeline=(
				"0 up open stand 150"
				"0 up shut stand 15"
				"0 up open stand 100"
				"0 wiggle open stand 20"
				"0 up open stand 20"
				"0 wiggle open stand 20"
				"0 up open stand 100"
				"0 wiggle shut stand 20"
				"0 up shut stand 20"
				"0 up open stand 15"
			)
		;;

		talk)
			motion_mouth=true

			timeline=(
				"0 up open stand $(( ${#pattern_mouth[@]} * delay_frame ))"
			)
		;;
	esac

	# hidden cursor - restored below the critter on ctrl+c when looping

	printf '\e[?25l'

	if [ "${loop_critter}" = true ]
	then
		trap "printf '\e[${height_frame}B\e[?25h\n'; exit 0" INT TERM
	fi

	while true
	do
		for entry in "${timeline[@]}"
		do
			read -r offset state_antenna state_eyes state_legs duration <<< "${entry}"

			printf -v padding '%*s' "${offset}" ''

			# mouth motion - frame held one frame delay at a time to keep talking

			if [ "${motion_mouth}" = true ]
			then
				count_chunk=$(( duration / delay_frame ))

				if [ "${count_chunk}" -lt 1 ]
				then
					count_chunk=1
				fi

				printf -v seconds '0.%02d' "${delay_frame}"
			else
				count_chunk=1

				printf -v seconds '%d.%02d' "$(( duration / 100 ))" "$(( duration % 100 ))"
			fi

			for (( index_chunk = 0 ; index_chunk < count_chunk ; index_chunk ++ ))
			do
				shape_mouth="${shapes_mouth[0]}"

				if [ "${motion_mouth}" = true ]
				then
					shape_mouth="${shapes_mouth[pattern_mouth[frame_mouth % ${#pattern_mouth[@]}]]}"

					frame_mouth=$(( frame_mouth + 1 ))
				fi

				lines_frame=(
					"${shapes_antenna[${state_antenna}]}"
					'   ▄▄▄▄▄▄▄▄▄▄'
					' ▄████████████▄'
					"${shapes_eyes[${state_eyes}]}"
					"${shape_mouth}"
					' ██████████████'
					"${shapes_legs[${state_legs}]}"
				)

				for line in "${lines_frame[@]}"
				do
					printf '\e[K%s%s%s%s\n' "${padding}" "${color_body}" "${line}" "${color_reset}"
				done

				# back to the top of the frame

				printf '\e[%sA' "${height_frame}"

				sleep "${seconds}"
			done
		done

		if [ "${loop_critter}" != true ]
		then
			break
		fi
	done

	# cursor below the critter

	printf '\e[%sB\e[?25h' "${height_frame}"

	frobulator.brk "${height_frame}"

	return "${status}"
}

# self ─────────────────────────────────────────────────────────────────────────

# declares frobulator's existence and loaded status for the current shell

# usage:      frobulator.self

frobulator.self () {

	local status=0

	frobulator_loaded="true"

	return "${status}"
}

frobulator.self

# calling script - absolute path for frobulator.complete labels

if [ -n "${BASH_SOURCE[1]}" ]
then
	frobulator_file_caller="$(realpath -- "${BASH_SOURCE[1]}" 2> "${sink}")"
fi

# install: default when executed

if [ "${option}" = "install" ]
then
	file_script="$(realpath "${BASH_SOURCE[0]}")"

	directory_script="$(dirname "${file_script}")"

	file_name="$(basename "${file_script}")"

	if [ "${directory_script}" -ef "${directory_install}" ]
	then
		frobulator.inf "Already installed" "[ ${directory_install}/${file_name} ]"
	else
		frobulator.copy "${directory_script}" "${directory_install}" "${file_name}"

		frobulator.permissions public execute "${directory_install}/${file_name}"

		frobulator.scs "Installed" "[ ${directory_install}/${file_name} ]"
	fi

	# release option

	unset option
fi

# critter: easter egg - not listed in help or readme

if [ "${option}" = "critter" ]
then
	frobulator.critter loop "${arguments_critter[@]}"

	unset option
	unset arguments_critter
fi

