# result:     ────────────────────────────────────────────────────────────...───
#
# command:    frobulator.sep lime "[string]"
# result:     ─────── string - line and string in the palette color - uncolored otherwise

frobulator.sep () {

	local status=0

	local gap
	local color_separator

	# optional palette color first - line and string in that color - added colors included

	if [[ "$(printf ' %s ' "${colors_selection[@]%%=*}")" == *" ${1} "* ]]
	then
		color_separator="${!1}"

		shift
	fi

	frobulator.pmt "${@}"

	prompt="${prompt_string[@]}"

	# gap after marker like other markers: space before text - line character otherwise

	if [ -n "${1}" ]
	then
		gap="${marker_spc}"
	else
		gap="${marker_sep:0:1}"
	fi

	echo -e "${color_separator}${marker_sep}${gap}${prompt}${color_separator:+${reset}}"

	frobulator.brk

	unset entry_color

	return "${status}"
}

# notify ───────────────────────────────────────────────────────────────────────
#
# framed message block with header:
# use to separate notices and messages from execution blocks
# supports message type designation for colorized output:
# a type before the title colors the title - a type before the message colors the message
#
#
# usage:	frobulator.ntf "title" "message"
#			frobulator.ntf [style] [split] [type] "title" [type] "message"
#
# command:	frobulator.ntf style "title" "message"
# result:
#
# ┌────────────────────────────────────────────────────────────────────────────┐
# │ title                                                                      │
# ├────────────────────────────────────────────────────────────────────────────┤
# │ message                                                                    │
# └────────────────────────────────────────────────────────────────────────────┘
#
# command:	frobulator.ntf style split "title" "message"
# result:
#
# ┌────────────────────────────────────────────────────────────────────────────┐
# │ title                                                                      │
# └────────────────────────────────────────────────────────────────────────────┘
# ┌────────────────────────────────────────────────────────────────────────────┐
# │ message                                                                    │
# └────────────────────────────────────────────────────────────────────────────┘
#

frobulator.ntf () {

	local lines_notice=0
	local count_lines_before="${lines_printed_terminal}"

	local rows_notice_line
	local rows_notice
	local style
	local title
	local split
	local message
	local type_prompt
	local types_prompt
	local color_title
	local color_message
	local count_character
	local span_content
	local width_title
	local width_message
	local frame_horizontal_top
	local frame_horizontal_middle
	local frame_horizontal_bottom
	local frame_vertical_left
	local frame_vertical_right
	local frame_top_left
	local frame_top_right
	local frame_middle_left
	local frame_middle_right
	local frame_bottom_left
	local frame_bottom_right
	local count_frame_vertical_left
	local count_frame_vertical_right
	local count_marker_elp
	local count_marker_spc
	local line_top
	local line_middle
	local line_bottom
	local frame_top
	local frame_middle
	local frame_bottom
	local line_message

	style="square"

	title="Notice"

	split=""

	unset color_title
	unset color_message

	types_prompt=(nil inf wrn msg add rem ret rel fwd rev stp dwl upl lnk scs err ins cpt url)

	# arguments

	while true
	do
		if [ "${1}" = "square" ] ||
		   [ "${1}" = "round"  ] ||
		   [ "${1}" = "heavy"  ] ||
		   [ "${1}" = "double" ] ||
		   [ "${1}" = "dots"   ] ||
		   [ "${1}" = "matrix" ] ||
		   [ "${1}" = "tech"   ] ||
		   [ "${1}" = "skel"   ] ||
		   [ "${1}" = "ascii"  ]
		then
			style="${1}"

			shift

		elif [ "${1}" = "split" ]
		then
			split="true"

			shift

		elif [[ " ${types_prompt[*]} " = *" ${1} "* ]]
		then
			type_prompt="${1}"

			shift

			frobulator."${type_prompt}" > ${sink}

			color_title=${entry_color[@]}

		else
			break
		fi
	done

	if [ $# -eq 0 ]
	then
		title="${title}"
		message=""

	elif [ $# -eq 1 ]
	then
		title="${title}"
		message="${1}"

	else
		title="${1}"

		shift

		# split and message type after the title

		while [ $# -gt 1 ]
		do
			if [ "${1}" = "split" ]
			then
				split="true"

				shift

			elif [[ " ${types_prompt[*]} " = *" ${1} "* ]]
			then
				type_prompt="${1}"

				shift

				frobulator."${type_prompt}" > ${sink}

				color_message=${entry_color[@]}
			else
				break
			fi
		done

		message="${@}"
	fi

	# columns

	if [ -z "${columns_terminal}" ]
	then
		count_character=80
	else
		count_character="${columns_terminal}"
	fi

	# default frame style

	frame_horizontal_top='─'
	frame_horizontal_middle='─'
	frame_horizontal_bottom='─'

	frame_vertical_left='│'
	frame_vertical_right='│'

	frame_top_left='┌'
	frame_top_right='┐'
	frame_middle_left='├'
	frame_middle_right='┤'
	frame_bottom_left='└'
	frame_bottom_right='┘'

	# alternate frame styles

	if [ "${style}" = "round" ]
	then
		frame_top_left='╭'
		frame_top_right='╮'
		frame_bottom_left='╰'
		frame_bottom_right='╯'

	elif [ "${style}" = "skel" ]
	then
		frame_vertical_left=' '
		frame_vertical_right=' '

	elif [ "${style}" = "heavy" ]
	then
		frame_horizontal_top='━'
		frame_horizontal_middle='━'
		frame_horizontal_bottom='━'

		frame_vertical_left='┃'
		frame_vertical_right='┃'

		frame_top_left='┏'
		frame_top_right='┓'
		frame_middle_left='┣'
		frame_middle_right='┫'
		frame_bottom_left='┗'
		frame_bottom_right='┛'

	elif [ "${style}" = "double" ]
	then
		frame_horizontal_top='═'
		frame_horizontal_middle='═'
		frame_horizontal_bottom='═'

		frame_vertical_left='║'
		frame_vertical_right='║'

		frame_top_left='╔'
		frame_top_right='╗'
		frame_middle_left='╠'
		frame_middle_right='╣'
		frame_bottom_left='╚'
		frame_bottom_right='╝'

	elif [ "${style}" = "ascii" ]
	then
		frame_horizontal_top='-'
		frame_horizontal_middle='-'
		frame_horizontal_bottom='-'

		frame_vertical_left='|'
		frame_vertical_right='|'

		frame_top_left='+'
		frame_top_right='+'
		frame_middle_left='+'
		frame_middle_right='+'
		frame_bottom_left='+'
		frame_bottom_right='+'

	elif [ "${style}" = "dots" ]
	then
		frame_horizontal_top='⠉'
		frame_horizontal_middle='⠒'
		frame_horizontal_bottom='⠤'

		frame_vertical_left='⠇'
		frame_vertical_right='⠸'

		frame_top_left='⠏'
		frame_top_right='⠹'
		frame_middle_left='⠗'
		frame_middle_right='⠺'
		frame_bottom_left='⠧'
		frame_bottom_right='⠼'

	elif [ "${style}" = "matrix" ]
	then
		frame_horizontal_top='▓'
		frame_horizontal_middle='▓'
		frame_horizontal_bottom='▓'

		frame_vertical_left='▓'
		frame_vertical_right='▓'

		frame_top_left='▓'
		frame_top_right='▓'
		frame_middle_left='▓'
		frame_middle_right='▓'
		frame_bottom_left='▓'
		frame_bottom_right='▓'

	elif [ "${style}" = "tech" ]
	then
		frame_vertical_left='║'
		frame_vertical_right='║'

		frame_top_left='╓'
		frame_top_right='╖'
		frame_middle_left='╟'
		frame_middle_right='╢'
		frame_bottom_left='╙'
		frame_bottom_right='╜'
	fi

	# width setup

	count_frame_vertical_left=${#frame_vertical_left}
	count_frame_vertical_right=${#frame_vertical_right}

	count_marker_elp=${#marker_elp}
	count_marker_spc=${#marker_spc}

	span_content=$(( count_character - count_frame_vertical_left - count_frame_vertical_right ))

	width_title=$(( span_content - count_marker_spc - count_marker_spc ))
	width_message=$(( span_content - count_marker_spc - count_marker_spc ))

	# horizontal frame setup

	while [ ${#line_top} -lt "${span_content}" ]
	do
		line_top="${line_top}${frame_horizontal_top}"
	done

	while [ ${#line_middle} -lt "${span_content}" ]
	do
		line_middle="${line_middle}${frame_horizontal_middle}"
	done

	while [ ${#line_bottom} -lt "${span_content}" ]
	do
		line_bottom="${line_bottom}${frame_horizontal_bottom}"
	done

	frame_top="${frame_top_left}${line_top}${frame_top_right}"
	frame_middle="${frame_middle_left}${line_middle}${frame_middle_right}"
	frame_bottom="${frame_bottom_left}${line_bottom}${frame_bottom_right}"

	# title frame

	echo "${frame_top}"

	lines_notice=$(( lines_notice + 1 ))

	title="${marker_spc}${title}${marker_spc}"

	if [ ${#title} -gt "${span_content}" ]
	then
		title="${title:0:$(( span_content - count_marker_elp - count_marker_spc ))}${marker_elp}${marker_spc}"
	fi

	while [ ${#title} -lt "${span_content}" ]
	do
		title="${title}${marker_spc}"
	done

	echo -e "${frame_vertical_left}${color_title}${title}${reset}${frame_vertical_right}"

	lines_notice=$(( lines_notice + 1 ))

	# message frame

	if [ -n "${message}" ]
	then
		if [ -n "${split}" ]
		then
			echo "${frame_bottom}"
			echo "${frame_top}"

			lines_notice=$(( lines_notice + 2 ))
		else
			echo "${frame_middle}"

			lines_notice=$(( lines_notice + 1 ))
		fi

		if [ ${#message} -gt "${width_message}" ]
		then
			message=$(echo "${message}" | fold -s -w "${width_message}")
		else
			message="${message}"
		fi

		while IFS= read -r line_message
		do
			line_message="${marker_spc}${line_message}"

			while [ ${#line_message} -lt "${span_content}" ]
			do
				line_message="${line_message}${marker_spc}"
			done

			line_message="${line_message:0:${span_content}}"

			echo -e "${frame_vertical_left}${color_message}${line_message}${reset}${frame_vertical_right}"

			lines_notice=$(( lines_notice + 1 ))

		done <<< "${message}"
	fi

	echo "${frame_bottom}"

	lines_notice=$(( lines_notice + 1 ))

	# notice rows - each frame line wrapped at real terminal width

	rows_notice_line=$(( ( ${#frame_top} + columns_terminal_actual - 1 ) / columns_terminal_actual ))
	rows_notice=$(( lines_notice * rows_notice_line ))

	# silenced color lookups print no rows

	lines_printed_terminal="${count_lines_before}"

	frobulator.brk "${rows_notice}"

	# cleanup

	unset style
	unset title
	unset split
	unset message
	unset type_prompt
	unset types_prompt
	unset color_title
	unset color_message

	unset count_character
	unset span_content
	unset width_title
	unset width_message

	unset frame_horizontal_top
	unset frame_horizontal_middle
	unset frame_horizontal_bottom

	unset frame_vertical_left
	unset frame_vertical_right

	unset frame_top_left
	unset frame_top_right
	unset frame_middle_left
	unset frame_middle_right
	unset frame_bottom_left
	unset frame_bottom_right

	unset count_frame_vertical_left
	unset count_frame_vertical_right
	unset count_marker_elp
	unset count_marker_spc

	unset line_top
	unset line_middle
	unset line_bottom

	unset frame_top
	unset frame_middle
	unset frame_bottom

	unset line_message

	unset IFS
}

# erase ────────────────────────────────────────────────────────────────────────

# erases a defined number of lines above the current cursor position:
# wipes from that point down to the end of the screen

frobulator.erase () {

	local count_lines="${1}"

	frobulator.plo "${count_lines}"
}

# separate ─────────────────────────────────────────────────────────────────────

# use to separate instructions or warnings from prompts

# note:
# set up as predefined separator

# usage:      frobulator.separate

# command:    frobulator.separate
# result:     ────────────────────────────────────────────────────────────...───

frobulator.separate () {

	frobulator.sep

}

# read ─────────────────────────────────────────────────────────────────────────

# use to capture user input after frobulator.qst / frobulator.ipt / frobulator.usr

# sets newline for next prompt clearance

frobulator.read () {

	read ${@}

	echo
}

# script ───────────────────────────────────────────────────────────────────────

# use to mark the beginning of a script process
# shows the script name and version in a notice block
# optional description is shown above them

# usage:      frobulator.script "[description]"

frobulator.script () {

	local description="${1}"

	local message

	if [ -n "${description}" ]
	then
		message+="${description}${NLN}${NLN}"
	fi

	message+="Executing:${marker_spc}'${script}'"
	message+="${NLN}Version:${marker_spc}${marker_spc}${marker_spc}${version}"

	frobulator.ntf msg "Script" msg "${message}"
}

# type ─────────────────────────────────────────────────────────────────────────

# use to emulate typing on prompts:
# delay per character is randomized to create human-like typing effect
# speed: one digit - 0 to 9 - optional - default 9
# each step adds 0.02 seconds to the maximum delay - 0 is 0.02 - 9 is 0.20
# delay drawn between 0.02 seconds and the maximum - 0 is a steady 0.02 - about one screen refresh
# string: every argument after the speed - joined with spaces
# first argument not a single digit - no speed given - part of the string

# usage:      frobulator.type "[speed]" "[string]" ...

frobulator.type () {

	local level_speed="9"
	local text_type="${*}"

	local length_text
	local index_character
	local delay_maximum
	local delay_hundredths
	local delay_seconds

	if [[ "${1}" =~ ^[0-9]$ ]]
	then
		level_speed="${1}"
		text_type="${*:2}"
	fi

	# maximum delay in hundredths of a second - 2 to 20

	delay_maximum=$(( ( level_speed + 1 ) * 2 ))

	length_text=${#text_type}

	for (( index_character = 0 ; index_character < length_text ; index_character ++ ))
	do
		# random delay of 2 to maximum hundredths of a second

		delay_hundredths=$(( ( RANDOM % ( delay_maximum - 1 ) ) + 2 ))

		printf -v delay_seconds '0.%02d' "${delay_hundredths}"

		echo -n -e "${text_type:${index_character}:1}"

		sleep "${delay_seconds}"
	done

	echo
}

# timeout ──────────────────────────────────────────────────────────────────────

# use to mark timeout in between commands in seconds

# usage:      frobulator.timeout "[seconds]"

frobulator.timeout () {

	local seconds="${1}"

	# set defaults

	if [ -z "${seconds}" ]
	then
		seconds="1"
	fi

	sleep "${seconds}"
}

# clear ────────────────────────────────────────────────────────────────────────

# use for script process 'paging':
# clears previous step when all checkpoint markers are met

frobulator.clear () {

	frobulator.timeout

	clear
}

# countdown ────────────────────────────────────────────────────────────────────

# use as countdown marker before next command runs:
# leaves preset time for long interaction with prompts and other long strings

# usage:      frobulator.countdown "[seconds]" "[string]" "[string]"

frobulator.countdown () {

	local status=0
	local counter="${1}"
	local seconds=1
	local before="[${marker_spc}${marker_spc}"
	local after="${marker_spc}${marker_spc}]"

	local ticker
	local prompt

	shift

	if [ -z "${counter}" ]
	then
		frobulator.err "No countdown specified"

		return 1
	fi

	if [[ ! "${counter}" =~ ^[0-9]+$ ]]
	then
		frobulator.err "Invalid countdown" "[ ${counter} ]"

		return 1
	fi

	frobulator.pmt "${@}"

	frobulator.track

	prompt="${prompt_string[*]}"

	while [ "${counter}" -ge 0 ]
	do
		if [ "${counter}" -eq 0 ]
		then
			ticker="-"

			echo -n -e "\r${before}${orange}${ticker}${reset}${after}${marker_spc}${prompt}\c"

			break
		else
			echo -n -e "\r${before}${red}${counter}${reset}${after}${marker_spc}${prompt}\c"

			counter=$(( counter - 1 ))
		fi

		sleep "${seconds}"

		frobulator.track || break
	done

	echo
	echo

	return "${status}"

}

# actions ──────────────────────────────────────────────────────────────────────

# action verbage parser:
# handles simple action verb placement and syntax substitution

# use in frobulator action calls in frobulator.progress

frobulator.action () {

	local status=0
	local action="${1}"

	local color
	local detail_progress
	local text_vowels

	local -a list_vowel_groups=()

	# two syllable verbs that still double their final consonant - stress on the last syllable

	local -a list_doubling=(
		admit
		begin
		commit
		compel
		control
		emit
		equip
		forget
		format
		occur
		omit
		permit
		prefer
		quit
		refer
		regret
		submit
		transfer
	)

	local -a detail=()
	local -a list_colors=(

		"${magenta}"
		"${purple}"
		"${blue}"
		"${navy}"
		"${red}"
		"${crimson}"
		"${yellow}"
		"${orange}"
		"${aqua}"
		"${teal}"
		"${black}"
		"${green}"
		"${lime}"
		"${silver}"
		"${grey}"
	)

	if [ "${#}" -gt 0 ]
	then
		shift
	fi

	detail=("${@}")

	# set action fallback

	if [ -z "${action}" ]
	then
		action="frobulate"
	fi

	action="${action,,}"

	# select random action color

	color="${list_colors[RANDOM % ${#list_colors[@]}]}"

	# conjugate action

	action="${action^}"

	# syllable count - one per group of vowels

	text_vowels="${action,,}"
	text_vowels="${text_vowels//[^aeiou]/ }"

	read -r -a list_vowel_groups <<< "${text_vowels}"

	if [ "${action: -2}" = "ie" ]
	then
		action="${action/%ie/y}"

	elif [ "${action: -1}" = "e" ] && [ "${action: -2}" != "ee" ]
	then
		action="${action/%e/}"

	elif [[ "${action,,}" =~ [^aeiou]ic$ ]]
	then
		action="${action}k"

	# final consonant doubled - one syllable ending consonant vowel consonant - or a listed verb

	elif [[ "${action,,}" =~ [^aeiou][aeiou][bcdfghjklmnpqrstvz]$ ]] &&
	     { [ "${#list_vowel_groups[@]}" -eq 1 ] || [[ " ${list_doubling[*]} " == *" ${action,,} "* ]]; }
	then
		action="${action}${action: -1}"
	fi

	action="${action}ing"

	if [ "${#detail[@]}" -eq 0 ]
	then
		action="${action}${marker_elp}"
	fi

	# generate prompt

	if [ "${#detail[@]}" -gt 0 ]
	then
		detail_progress="${detail[*]}"

		frobulator.pmt "${action}" "${detail_progress}"
	else
		frobulator.pmt "${action}"
	fi

	frobulator.track

	prompt_progress="${prompt_string[*]}"
	color_progress="${color}"

	return "${status}"

}

# process ──────────────────────────────────────────────────────────────────────

# use as ticker line marker to mark process completion or progress
# use after process marked for background operation

# usage:      [process] &
#             frobulator.process "[string]"

frobulator.process () {

	# capture process identifier of last background command

	local PID=${!}
	local seconds="0.25"
	local ticker='/\'
	local before="[${marker_spc}${marker_spc}"
	local after="${marker_spc}${marker_spc}]"
	local instance=1

	local status
	local prompt
	local frame_ticker

	if [ -z "${PID}" ]
	then
		frobulator.err "No background process detected"

		return 1
	fi

	frobulator.pmt "${@}"

	prompt="${prompt_string[@]}"

	# at least one frame - a process done before the first frame still gets its line

	while true
	do
		frame_ticker="${ticker:instance++%${#ticker}:1}"

		echo -n -e "\r${before}${color} \b${frame_ticker}${reset}${after}${marker_spc}${prompt}\c"

		if [ ! -d "/proc/${PID}" ]
		then
			break
		fi

		sleep "${seconds}"
	done

	wait "${PID}"

	status="${?}"

	echo
	echo

	return "${status}"
}

# progress ─────────────────────────────────────────────────────────────────────

# use as ticker line marker to mark process wait progress
# use after process marked to for in background
# refer to frobulator.action for actions list

# usage:      [process] &
#             frobulator.progress "[action]"

frobulator.progress () {

	# capture process identifier of last background command

	local PID=${!}
	local seconds="0.25"
	local ticker='⎺⎻⎼⎽⎼⎻'
	local before="[${marker_spc}${marker_spc}"
	local after="${marker_spc}${marker_spc}]"
	local instance=1

	local status
	local frame_ticker
	local prompt_progress
	local color_progress

	if [ -z "${PID}" ]
	then
		frobulator.err "No background process detected"

		return 1
	fi

	frobulator.action "${@}"

	# at least one frame - a process done before the first frame still gets its line

	while true
	do
		frame_ticker="${ticker:instance++%${#ticker}:1}"

		echo -n -e "\r${before}${color_progress} \b${frame_ticker}${reset}${after}${marker_spc}${prompt_progress}\c"

		if [ ! -d "/proc/${PID}" ]
		then
			break
		fi

		sleep "${seconds}"
	done

	wait "${PID}"

	status="${?}"

	echo
	echo

	unset entry_color
	unset prompt_progress
	unset color_progress

	return "${status}"
}

# bar ──────────────────────────────────────────────────────────────────────────

# use to run a command with an estimated activity bar

# note:
#	        not a true progress meter
#	        estimates progress while the process is running
#	        only reaches 100 percent when the process exits

# usage:
#	        frobulator.bar sleep 5
#	        frobulator.bar apt-get update
#	        frobulator.bar rsync -av source/ destination/

frobulator.bar () {

	local command
	local id_process
	local status_process
	local seconds
	local count_character
	local count_before
	local count_after
	local count_buffer
	local current_progress
	local limit_progress
	local percent_progress
	local done_progress
	local left_progress
	local line_progress_done
	local line_progress_left
	local line_progress
	local label_progress

	if [ $# -eq 0 ]
	then
		frobulator.err "Missing command"

		return 1
	fi

	# defaults

	seconds="0.25"

	current_progress=0
	limit_progress=99

	# columns

	if [ -z "${columns_terminal}" ]
	then
		count_character=80
	else
		count_character="${columns_terminal}"
	fi

	# reserved output width

	count_before=0
	count_after=8

	count_buffer=$(( count_character - count_before - count_after ))

	# run command

	command=${@}

	"${SHELL}" -c "${command}" >> "${sink}" 2>&1 &

	id_process=$!

	# monitor process

	while [ -d /proc/"${id_process}" ]
	do
		# simulated progress

		if [ "${current_progress}" -lt 70 ]
		then
			current_progress=$(( current_progress + 2 ))

		elif [ "${current_progress}" -lt 90 ]
		then
			current_progress=$(( current_progress + 1 ))

		elif [ "${current_progress}" -lt "${limit_progress}" ]
		then
			current_progress=$(( current_progress + 0 ))

		fi

		# progress calculation

		percent_progress="${current_progress}"

		done_progress=$(( percent_progress * count_buffer / 100 ))
		left_progress=$(( count_buffer - done_progress ))

		# progress line

		line_progress_done=$(printf "%${done_progress}s")
		line_progress_left=$(printf "%${left_progress}s")

		line_progress_done="${line_progress_done// /|}"
		line_progress_left="${line_progress_left// /-}"

		line_progress="${line_progress_done}${line_progress_left}"

		# percentage padding

		if [ "${percent_progress}" -lt 10 ]
		then
			label_progress="00${percent_progress}"

		elif [ "${percent_progress}" -lt 100 ]
		then
			label_progress="0${percent_progress}"

		else
			label_progress="${percent_progress}"
		fi

		# output

		echo -n -e "\r[${marker_spc}${label_progress}${marker_spc}${line_progress}${marker_spc}]"

		sleep "${seconds}"
	done

	# collect exit code

	wait ${id_process}

	status_process=$?

	# force completion

	percent_progress=100

	done_progress=$(( percent_progress * count_buffer / 100 ))
	left_progress=$(( count_buffer - done_progress ))

	line_progress_done=$(printf "%${done_progress}s")
	line_progress_left=$(printf "%${left_progress}s")

	line_progress_done="${line_progress_done// /|}"
	line_progress_left="${line_progress_left// /-}"

	line_progress="${line_progress_done}${line_progress_left}"

	label_progress="100"

	# final output

	if [ "${status_process}" -eq 0 ]
	then
		echo -n -e "\r[${marker_spc}${label_progress}${marker_spc}${line_progress}${marker_spc}]"
	fi

	echo
	echo

	# cleanup

	unset command

	unset id_process
	unset status_process

	unset seconds

	unset count_character
	unset count_before
	unset count_after
	unset count_buffer

	unset current_progress
	unset limit_progress
	unset percent_progress

	unset done_progress
	unset left_progress

	unset line_progress_done
	unset line_progress_left
	unset line_progress

	unset label_progress

	return ${status_process}

}

# temporary ────────────────────────────────────────────────────────────────────

# use to generate temporary directory from argument or array list
# generates directory template as 'frobulator_temporary_XXXXXX'
# useful for program builds and process transfer features

# usage:      frobulator.temporary "[directory name]" | "[array name]"

frobulator.temporary () {

	local status=0
	local template_temporary="frobulator.temporary.XXXXXX"

	local variable_temporary
	local directory_created

	# each argument names a variable that receives a new temporary directory

	for variable_temporary in "${@}"
	do
		directory_created="$(mktemp -d -t "${template_temporary}")"

		frobulator.track || continue

		eval "${variable_temporary}=\"${directory_created}\""

		frobulator.add "Generating temporary directory" "[ ${variable_temporary} ]"

		frobulator_return+=("${directory_created}")
	done

	return "${status}"
}

# trap ─────────────────────────────────────────────────────────────────────────

# use to cleanup temporary directory or other process driven execution
# handles exit codes and signals to ensure proper cleanup
# specify directory name as variable
# variable is returned from 'eval' into frobulator.temporary

# usage:         frobulator.temporary "[variable name]"
#                frobulator.trap "${variable name}" ["${other directory}" ...]

# signal        value    action    comment
# ──────────────────────────────────────────────────────────────────────────────
# SIGTERM       15       Term      Termination signal
# SIGINT         2       Term      CONTROL+C interrupt from keyboard
# SIGHUP         1       Term      Disconnected terminal or parent died
# SIGPIPE       13       Term      Broken pipe
# SIGALRM(*)    14       Term      Timer signal from alarm
# SIGUSR2(*)    12       Term      User-defined signal 2
# SIGUSR1(*)    10       Term      User-defined signal 1
# SIGQUIT        3       Core      CONTRL+\ or quit from keyboard
# SIGABRT        6       Core      Abort signal from abort(3)
# SIGSEGV       11       Core      Invalid memory reference
# SIGILL         4       Core      Illegal Instruction
# SIGFPE         8       Core      Floating point exception
# SIGKILL        9       Term      Kill signal
# ──────────────────────────────────────────────────────────────────────────────

frobulator.trap () {

	local status=0
	local command_trap="rm --recursive --force --"

	local directory_trap

	# every directory passed in any call is removed on exit:
	# paths are fixed now - never read from variables at exit time

	for directory_trap in "${@}"
	do
		if [ -n "${directory_trap}" ] && [ "${directory_trap}" != "/" ]
		then
			frobulator_directories_trap+=("${directory_trap}")
		fi
	done

	for directory_trap in "${frobulator_directories_trap[@]}"
	do
		command_trap+=" $(printf '%q' "${directory_trap}")"
	done

	# clean on interruption or error

	trap "exit 1" HUP INT PIPE QUIT TERM

	frobulator.track

	# clean on exit

	trap "${command_trap}" EXIT

	frobulator.track

	return "${status}"
}

# complete ─────────────────────────────────────────────────────────────────────

# BASH exit status codes ───────────────────────────────────────────────────────

# exit status codes are integers returned by commands upon completion
# a successful command typically returns an exit status of 0
# non-zero values generally indicate an error or abnormal termination

# common exit status codes ─────────────────────────────────────────────────────

# code     definition                           example

# 0        success                              true
# 1        generic error                        false
# 2        misuse of shell builtins             'cd /nonexistent/directory'

# 126      command invoked cannot execute       'bash /nonexistent_script'    (assume script lacks executable permissions)
# 127      command not found                    'nonexistent_command'
# 128+n    fatal error - signal "n"             'kill -9 $$'                  (send SIGKILL to current process)
# 130      terminated  - signal 2 (sigint)      'kill -2 $!'                  (send SIGINT to background process)
# 137      terminated  - signal 9 (sigkill)     'kill -9 $!'                  (send SIGKILL to background process)
# 139      terminated  - signal 11 (sigsegv)                                  (program with memory access violations)
# 143      terminated  - signal 15 (sigterm)    'kill -15 $!'                 (send SIGTERM to background process)

# 255*     out of range - exit -1

# complete ─────────────────────────────────────────────────────────────────────

# frobulator.complete [ continue | halt ] [ message ] [ detail ]
#         │
#         ├── capture previous command status
#         │       or
#         ├── execute command (checkpoint form)
#         ├── record checkpoint and status
#         │
#         ├── success ── report complete ── continue execution
#         │
#         └── failure ── report message or incomplete ── log failure
#                     │
#                     ├── continue ── continue execution
#                     └── halt ────── frobulator.result ── exit script
#
# frobulator.fail
#         └── failure ── report and log ── return status to calling function
#
# frobulator.halt
#         └── failure ── report and log ── frobulator.result ── exit script
#
#                end of script
#                     │
#                     ▼
#                frobulator.result
#                     │
#                     ├── summarize statuses
#                     ├── clear checkpoints
#                     ├── clear statuses
#                     └── return overall status

# capture previous command status when used without arguments
# continue (default): record and report failures - then carry on
# halt: on failure report / log / print frobulator.result / exit the script
# label: calling function name - else previous command in the script - else operation number - message replaces it on failure
# execute command and record checkpoint status when arguments are supplied
# skip execution when checkpoint already completed successfully
# use immediately after command when used without arguments
# use in tandem with frobulator.result

# usage:    command

#           frobulator.complete

#           command

#           frobulator.complete continue "[message]" "[detail]"

#           command

#           frobulator.complete halt "[message]" "[detail]"

#           frobulator.complete [ continue | halt ] "[path]" "[checkpoint]" command [arguments...]

frobulator.complete () {

	local status_previous="${?}"
	local status=0
	local mode="continue"
	local keyword=false

	local message
	local detail
	local label
	local path
	local checkpoint
	local number_checkpoint
	local line
	local file_caller
	local index_line
	local name_command
	local argument_command

	local -a lines_caller=()

	# initialize collections

	if [ -z "${frobulator_initialized_complete}" ]
	then
		frobulator_statuses_complete=()
		frobulator_checkpoints_complete=()
		frobulator_initialized_complete=true
	fi

	# mode: continue (default) or halt

	if [ "${1}" = "continue" ] || [ "${1}" = "halt" ]
	then
		mode="${1}"
		keyword=true

		shift
	fi

	# record previous command status: no arguments or message and detail

	if [ "${#}" -le 2 ]
	then
		message="${1}"
		detail="${2}"
		status="${status_previous}"

		# label: calling function name - else previous command in the calling script - else operation number

		if [ "${FUNCNAME[1]}" != "main" ] && [ "${FUNCNAME[1]}" != "source" ]
		then
			label="${FUNCNAME[1]#frobulator.}"
			label="${label//_/ }"
		else
			# calling script - path kept at load if the script changed directory

			file_caller="${BASH_SOURCE[1]}"

			if [ ! -r "${file_caller}" ]
			then
				file_caller="${frobulator_file_caller}"
			fi

			if [ -r "${file_caller}" ]
			then
				mapfile -t lines_caller < "${file_caller}"

				# line above the call - blank lines and comments skipped

				index_line=$(( BASH_LINENO[0] - 2 ))

				while [ "${index_line}" -ge 0 ] && [[ "${lines_caller[index_line]}" =~ ^[[:space:]]*(#.*)?$ ]]
				do
					index_line=$(( index_line - 1 ))
				done

				# continued command - back to its first line

				while [ "${index_line}" -gt 0 ] && [[ "${lines_caller[index_line - 1]}" = *\\ ]]
				do
					index_line=$(( index_line - 1 ))
				done

				if [ "${index_line}" -ge 0 ]
				then
					read -r name_command argument_command _ <<< "${lines_caller[index_line]}"
				fi
			fi

			# background command followed by progress - progress action names it

			if [ "${name_command}" = "frobulator.progress" ]
			then
				name_command="${argument_command//\"/}"
			fi

			# silenced or logged command - wrapped command names it if written out

			if [ "${name_command}" = "frobulator.silence" ] || [ "${name_command}" = "frobulator.log" ]
			then
				argument_command="${argument_command//\"/}"

				if [[ "${argument_command}" =~ ^[A-Za-z_][A-Za-z0-9_.-]*$ ]]
				then
					name_command="${argument_command}"
				fi
			fi

			if [[ "${name_command}" =~ ^[A-Za-z_][A-Za-z0-9_.-]*$ ]]
			then
				label="${name_command#frobulator.}"
			else
				frobulator_operation_complete=$(( ${frobulator_operation_complete:-0} + 1 ))

				label="Operation ${frobulator_operation_complete}"
			fi
		fi

		frobulator_statuses_complete+=("${status}")
		frobulator_checkpoints_complete+=("${message:-${label}}")

		if [ "${status}" -eq 0 ]
		then
			frobulator.cpt "Complete - ${label}" "[ status ${status} ]"

			return 0
		fi

		if [ -n "${message}" ]
		then
			frobulator.err "${message}" "${detail}"
		else
			frobulator.wrn "Incomplete - ${label}" "[ status ${status} ]"
		fi

		# log failure

		line="$(date +"%Y-%m-%d %H:%M:%S") ${script##*/}: ${message:-${label}}${detail:+ ${detail}} [ status ${status} ]"

		frobulator.log "printf '%s\\n' $(printf '%q' "${line}")"

		if [ "${mode}" = "halt" ]
		then
			frobulator.result "${script##*/}"

			exit "${status}"
		fi

		return 0
	fi

	# assign checkpoint parameters

	path="${1}"
	checkpoint="${2}"

	shift 2

	# validate path

	if [ -z "${path}" ]
	then
		frobulator_statuses_complete+=("1")
		frobulator_checkpoints_complete+=("undefined checkpoint path")

		frobulator.err "Checkpoint path not defined"

		return 0
	fi

	# validate checkpoint

	if [ -z "${checkpoint}" ]
	then
		frobulator_statuses_complete+=("1")
		frobulator_checkpoints_complete+=("undefined checkpoint")

		frobulator.err "Checkpoint not defined"

		return 0
	fi

	# validate command

	if [ "${#}" -eq 0 ]
	then
		frobulator_statuses_complete+=("1")
		frobulator_checkpoints_complete+=("${checkpoint}")

		frobulator.err "Command not defined" "[ ${status} ] [ ${checkpoint} ]"

		return 0
	fi

	# check checkpoint

	if [ -f "${path}/${checkpoint}" ]
	then
		frobulator_statuses_complete+=("0")
		frobulator_checkpoints_complete+=("${checkpoint}")

		frobulator.cpt "Complete" "[ ${status} ] [ ${checkpoint} ]"

		return 0
	fi

	# run command

	"${@}"

	status="${?}"

	# collect status

	frobulator_statuses_complete+=("${status}")
	frobulator_checkpoints_complete+=("${checkpoint}")

	# manage checkpoint

	if [ "${status}" -eq 0 ]
	then
		frobulator.file "${path}" "${checkpoint}"

		if [ "${?}" -ne 0 ]
		then
			status=1

			frobulator_statuses_complete[-1]="${status}"

			frobulator.err "Checkpoint creation failed" "[ ${status} ] [ ${checkpoint} ]"
		else
			frobulator.cpt "Complete" "[ ${status} ] [ ${checkpoint} ]"
		fi
	else
		if [ -f "${path}/${checkpoint}" ]
		then
			rm --force -- "${path}/${checkpoint}"

			if [ "${?}" -ne 0 ]
			then
				status=1

				frobulator_statuses_complete[-1]="${status}"
			fi
		fi

		frobulator.wrn "Incomplete" "[ ${status} ] [ ${checkpoint} ]"

		# log failure

		line="$(date +"%Y-%m-%d %H:%M:%S") ${script##*/}: ${checkpoint} [ status ${status} ]"

		frobulator.log "printf '%s\\n' $(printf '%q' "${line}")"

		if [ "${mode}" = "halt" ]
		then
			frobulator.result "${script##*/}"

			exit "${status}"
		fi
	fi

	# continue process

	return 0
}

# halt ─────────────────────────────────────────────────────────────────────────

# use to stop the script when the previous command failed
# records the status for frobulator.result and logs the failure

# usage:      command
#             frobulator.halt
#             frobulator.halt "[message]" "[detail]"

frobulator.halt () {

	local status="${?}"

	local checkpoint
	local line

	# record status like frobulator.complete

	if [ -z "${frobulator_initialized_complete}" ]
	then
		frobulator_statuses_complete=()
		frobulator_checkpoints_complete=()
		frobulator_initialized_complete=true
	fi

	if [ "${status}" -eq 0 ]
	then
		return 0
	fi

	# record failure: label from calling function when no message

	if [ -n "${1}" ]
	then
		checkpoint="${1}"

	elif [ "${FUNCNAME[1]}" != "main" ] && [ "${FUNCNAME[1]}" != "source" ]
	then
		checkpoint="${FUNCNAME[1]//_/ }"
	else
		checkpoint="Operation"
	fi

	frobulator_statuses_complete+=("${status}")
	frobulator_checkpoints_complete+=("${checkpoint}")

	if [ -n "${1}" ]
	then
		frobulator.err "${@}"
	fi

	# log failure

	line="$(date +"%Y-%m-%d %H:%M:%S") ${script##*/}: ${checkpoint}${2:+ ${2}} [ status ${status} ]"

	frobulator.log "printf '%s\\n' $(printf '%q' "${line}")"

	frobulator.result "${script##*/}"

	exit "${status}"
}

# fail ─────────────────────────────────────────────────────────────────────────

# use to leave a function when the previous command failed
# records the status for frobulator.result and logs the failure
# returns the failed status: follow with '|| return' to leave the calling function

# usage:      command
#             frobulator.fail || return
#             frobulator.fail "[message]" "[detail]" || return

frobulator.fail () {

	local status="${?}"

	local checkpoint
	local line

	# record status like frobulator.complete

	if [ -z "${frobulator_initialized_complete}" ]
	then
		frobulator_statuses_complete=()
		frobulator_checkpoints_complete=()
		frobulator_initialized_complete=true
	fi

	if [ "${status}" -eq 0 ]
	then
		return 0
	fi

	# record failure: label from calling function when no message

	if [ -n "${1}" ]
	then
		checkpoint="${1}"

	elif [ "${FUNCNAME[1]}" != "main" ] && [ "${FUNCNAME[1]}" != "source" ]
	then
		checkpoint="${FUNCNAME[1]//_/ }"
	else
		checkpoint="Operation"
	fi

	frobulator_statuses_complete+=("${status}")
	frobulator_checkpoints_complete+=("${checkpoint}")

	if [ -n "${1}" ]
	then
		frobulator.err "${@}"
	fi

	# log failure

	line="$(date +"%Y-%m-%d %H:%M:%S") ${script##*/}: ${checkpoint}${2:+ ${2}} [ status ${status} ]"

	frobulator.log "printf '%s\\n' $(printf '%q' "${line}")"

	return "${status}"
}

# track ────────────────────────────────────────────────────────────────────────

# use after a command inside a function to record its failure in the caller's 'status'
# keeps the command's own exit status for further checks:
# frobulator.track || continue

# usage:      frobulator.track

frobulator.track () {

	local status_track="${?}"

	if [ "${status_track}" -ne 0 ]
	then
		status=1
	fi

	return "${status_track}"
}

# result ───────────────────────────────────────────────────────────────────────

# frobulator.result
#         │
#         ├── evaluate recorded statuses
#         ├── count failed checkpoints
#         ├── report final outcome
#         ├── clear recorded collections
#         └── return overall status

# evaluate statuses collected by frobulator.complete:
# report success when all checkpoints completed successfully
# report failure count when one or more checkpoints failed
# clear checkpoint and status collections after evaluation
# use in tandem with frobulator.complete

# usage:      frobulator.result "[instance]"

frobulator.result () {

	local status=0
	local count_error=0
	local instance="${1}"

	local status_complete

	# evaluate statuses

	for status_complete in "${frobulator_statuses_complete[@]}"
	do
		if [ "${status_complete}" -ne 0 ]
		then
			status=1

			count_error=$(( count_error + 1 ))
		fi
	done

	# clear collections

	frobulator_statuses_complete=()
	frobulator_checkpoints_complete=()

	# report result

	if [ "${status}" -ne 0 ]
	then
		frobulator.err "Execution failure" "[ ${instance} ]"

		frobulator.wrn "Errors encountered" "[ ${count_error} ] [ ${instance} ]"

		# same directory as frobulator.log

		if [ -z "${SUDO:-${HOME}}" ]
		then
			frobulator.inf "Review setup logs for details" "[ ${PREFIX}/var/log/ ]"
		else
			frobulator.inf "Review setup logs for details" "[ ${HOME}/.local/var/log/ ]"
		fi
	else
		frobulator.scs "Execution success" "[ ${instance} ]"
	fi

	unset frobulator_operation_complete

	return "${status}"

}

# ownership ────────────────────────────────────────────────────────────────────

# use to restore ownership after privileged operations

# usage:      frobulator.ownership [target]

frobulator.ownership () {

	local status=0

	local target
	local name_user
	local home_user
	local path_target
	local path_system
	local path
	local name_owner
	local id_user
	local id_group

	local -a list_system_paths=(

		/root
		/usr
		/etc
		/var
		/opt
		/boot
	)

	if [ "${#}" -eq 0 ]
	then
		frobulator.err "Missing ownership target"

		return 1
	fi

	list=("${@}")

	# determine user ownership source

	if [ -n "${SUDO_USER}" ]
	then
		name_user="${SUDO_USER}"
	else
		name_user="$(id -u -n)"

		if [ "${?}" -ne 0 ]
		then
			list=()

			return 1
		fi
	fi

	# determine user home

	home_user="/home/${name_user}"

	if [ "${name_user}" = "root" ]
	then
		home_user="/root"
	fi

	for target in "${list[@]}"
	do
		path_system="false"

		# resolve target path

		path_target="$(realpath -m "${target}")"

		frobulator.track || continue

		for path in "${list_system_paths[@]}"
		do
			if [[ "${path_target}" = "${path}"   ]] ||
			   [[ "${path_target}" = "${path}/"* ]]
			then
				path_system="true"

				break
			fi
		done

		# determine ownership context

		if [[ "${path_target}" = "${home_user}"   ]] ||
		   [[ "${path_target}" = "${home_user}/"* ]]
		then
			name_owner="${name_user}"

		elif [ "${path_system}" = "true" ]
		then
			name_owner="root"

		else
			name_owner="${name_user}"
		fi

		# resolve ownership identities

		id_user="$(id -u "${name_owner}")"

		frobulator.track || continue

		id_group="$(id -g "${name_owner}")"

		frobulator.track || continue

		# apply ownership

		chown							\
			"${id_user}:${id_group}"	\
			--recursive					\
										"${target}"

		frobulator.track
	done

	# unset array

	list=()

	return "${status}"
}

# permissions ──────────────────────────────────────────────────────────────────

# use to set permissions from scope and modifiers

# scope:      public     you edit / everyone reads
#             group      you edit / group reads / others no access
#             private    only you
# modifiers:  execute    whoever can read can also run
#             readonly   nobody edits - you included

#                           file          directory     typical use
# public                    644 rw-r--r-- 755 rwxr-xr-x regular files / configs / shared data
# public execute            755 rwxr-xr-x 755 rwxr-xr-x scripts / binaries / installed tools
# public readonly           444 r--r--r-- 555 r-xr-xr-x reference files that should not change
# public readonly execute   555 r-xr-xr-x 555 r-xr-xr-x locked-down tools
# group                     640 rw-r───── 750 rwxr-x─── files for your group only
# group execute             750 rwxr-x─── 750 rwxr-x─── group-only scripts
# group readonly            440 r--r───── 550 r-xr-x─── group reference files
# group readonly execute    550 r-xr-x─── 550 r-xr-x─── locked group tools
# private                   600 rw─────── 700 rwx────── credentials / keys / tokens
# private execute           700 rwx────── 700 rwx────── personal scripts
# private readonly          400 r──────── 500 r-x────── ssh keys / certificates
# private readonly execute  500 r-x────── 500 r-x────── locked personal tools

# usage:      frobulator.permissions "[scope]" "[modifiers]" "[target]" | "[array]"

# command:    frobulator.permissions public execute "${path}/${file}"
# command:    frobulator.permissions private "${HOME}/.git-credentials"

frobulator.permissions () {

	local status=0
	local scope="${1}"
	local execute=false
	local readonly=false

	local target
	local runnable
	local mode_owner
	local mode_group
	local mode_others

	# scope

	if [ -z "${scope}" ]
	then
		frobulator.err "Missing permissions scope"

		return 1
	fi

	if [ "${scope}" != "public" ] && [ "${scope}" != "group" ] && [ "${scope}" != "private" ]
	then
		frobulator.err "Invalid permissions scope" "[ '${scope}' ]"

		return 1
	fi

	shift

	# modifiers

	while [ "${#}" -gt 0 ]
	do
		if [ "${1}" = "execute" ]
		then
			execute=true

		elif [ "${1}" = "readonly" ]
		then
			readonly=true
		else
			break
		fi

		shift
	done

	# targets

	if [ "${#}" -eq 0 ]
	then
		frobulator.err "Missing permissions target"

		return 1
	fi

	local -a list=("${@}")

	for target in "${list[@]}"
	do
		# directories need execute

		runnable=false

		if [ "${execute}" = true ] || [ -d "${target}" ]
		then
			runnable=true
		fi

		# owner

		mode_owner="r"

		if [ "${readonly}" = false ]
		then
			mode_owner+="w"
		fi

		if [ "${runnable}" = true ]
		then
			mode_owner+="x"
		fi

		# group

		mode_group=""

		if [ "${scope}" = "public" ] || [ "${scope}" = "group" ]
		then
			mode_group="r"

			if [ "${runnable}" = true ]
			then
				mode_group+="x"
			fi
		fi

		# others

		mode_others=""

		if [ "${scope}" = "public" ]
		then
			mode_others="r"

			if [ "${runnable}" = true ]
			then
				mode_others+="x"
			fi
		fi

		# apply permissions

		chmod "u=${mode_owner},g=${mode_group},o=${mode_others}" "${target}"

		frobulator.track
	done

	return "${status}"
}

# directory ────────────────────────────────────────────────────────────────────

# use to generate directory from argument or array list

# "${path}" defaults to "${PWD}" when omitted

# usage:      frobulator.directory "[/path/string]" | "[path]" "[directory name]" | "[array name]"

frobulator.directory () {

	local status=0

	local path
	local directory
	local directory_item

	if [ "${#}" -eq 1 ]
	then
		if [[ "${1}" = */* ]]
		then
			path="${1%/*}"

			directory_item="${1##*/}"
		else
			path="${PWD}"

			directory_item="${1}"
		fi

		list=()

		list+=("${directory_item}")
	fi

	if [ "${#}" -ge 2 ]
	then
		path="${1}"

		if [[ "${#list[@]}" -gt 0 ]]
		then
			# ${2} - array

			list=("${@:2}")
		else
			directory_item="${2}"

			list=()

			list+=("${directory_item}")
		fi

		shift
	fi

	for directory in "${list[@]}"
	do
		frobulator.add "Generating directory" "[ ${directory} ]"

		# create directory and set permissions

		if [ ! -d "${path}/${directory}" ]
		then
			mkdir --parents "${path}/${directory}"

			frobulator.track || continue
		fi

		# set ownership

		frobulator.ownership "${path}/${directory}"

		frobulator.track
	done

	# unset array

	list=()

	return "${status}"

}

# write ────────────────────────────────────────────────────────────────────────

# use to generate and write to file(s) from argument or array list
# writes content to file according to mode: prepend, write, append

# "${path}" defaults to "${PWD}" when omitted

# usage:      frobulator.write "[mode]" "[content]" "[path]" "[file]"

frobulator.write () {

	local status=0
	local mode="${1}"
	local content="${2}"

	local path
	local file
	local file_prepend

	if [ "${#}" -eq 3 ]
	then
		path="${PWD}"

		if [[ "${#list[@]}" -gt 0 ]]
		then
			# ${3} - array

			list=("${@:3}")
		else
			file="${3}"

			list=()

			list+=("${file}")
		fi
	fi

	if [ "${#}" -eq 4 ]
	then
		path="${3}"

		if [ -z "${path}" ]
		then
			path="${PWD}"
		fi

		if [[ "${#list[@]}" -gt 0 ]]
		then
			# ${4} - array

			list=("${@:4}")
		else
			file="${4}"

			list=()

			list+=("${file}")
		fi
	fi

	if [ ! -d "${path}" ]
	then
		mkdir --parents "${path}"

		frobulator.track || return 1
	fi

	for file in "${list[@]}"
	do
		frobulator.add "Writing" "[ ${file} ]"

		# write to file according to mode

		if [ "${mode}" = "prepend" ]
		then
			file_prepend="$(mktemp)"

			echo "${content}" > "${file_prepend}"

			if [ -f "${path}/${file}" ]
			then
				cat "${path}/${file}" >> "${file_prepend}"
			fi

			mv "${file_prepend}" "${path}/${file}"

		elif [ "${mode}" = "write" ]
		then
			echo "${content}" > "${path}/${file}"

		else
			echo "${content}" >> "${path}/${file}"
		fi

		frobulator.track || continue

		# set ownership

		frobulator.ownership "${path}/${file}"

		frobulator.track
	done

	# unset array

	list=()

	return "${status}"

}

# file ─────────────────────────────────────────────────────────────────────────

# use to generate file(s) from argument or array list

# usage:      frobulator.file "[path]" "[file]" | "[array]"

frobulator.file () {

	local status=0

	local path
	local file

	if [ "${#}" -eq 1 ]
	then
		path="${PWD}"

		if [[ "${#list[@]}" -gt 0 ]]
		then
			# ${1} - array

			list=("${@:1}")
		else
			file="${1}"

			list=()

			list+=("${file}")
		fi
	fi

	if [ "${#}" -eq 2 ]
	then
		path="${1}"

		if [[ "${#list[@]}" -gt 0 ]]
		then
			# ${2} - array

			list=("${@:2}")
		else
			file="${2}"

			list=()

			list+=("${file}")
		fi
	fi

	if [ ! -d "${path}" ]
	then
		mkdir --parents "${path}"

		frobulator.track || return 1
	fi

	for file in "${list[@]}"
	do
		frobulator.add "Generating" "[ ${file} ]"

		# create file and set permissions

		if [ ! -f "${path}/${file}" ]
		then
			touch "${path}/${file}"

			frobulator.track || continue
		fi

		# set ownership

		frobulator.ownership "${path}/${file}"

		frobulator.track
	done

	# unset array

	list=()

	return "${status}"

}

# keep ─────────────────────────────────────────────────────────────────────────

# use to reverse-select file(s) for deletion from argument or array list
# keeps selected files in directory

# usage:      frobulator.keep "[path]" "[file]" | "[array]"

frobulator.keep () {

	local status=0

	local path
	local file
	local item
	local keep

	if [ "${#}" -eq 1 ]
	then
		path="${PWD}"

		if [[ "${#list[@]}" -gt 0 ]]
		then
			# ${1} - array

			list=("${@:1}")
		else
			file="${1}"

			list=()

			list+=("${file}")
		fi
	fi

	if [ "${#}" -ge 2 ]
	then
		path="${1}"

		if [[ "${#list[@]}" -gt 0 ]]
		then
			# ${2} - array

			list=("${@:2}")
		else
			file="${2}"

			list=()

			list+=("${file}")
		fi

		shift
	fi

	if [ -d "${path}" ]
	then
		# enter path and parse items

		cd "${path}"

		frobulator.track || return 1

		for item in *
		do
			keep=0

			for file in "${list[@]}"
			do
				# mark for keeping

				if [[ "${path}/${file}" = "${path}/${item}" ]]
				then
					keep=1

					frobulator.ret "Keeping" "[ ${file} ]"
				fi
			done

			# remove unmarked items

			if [ "${keep}" -eq 0 ]
			then
				rm --recursive --force "${path}/${item}"

				frobulator.track
			fi
		done
	else
		frobulator.err "Path does not exist" "[ ${path} ]"

		return 1
	fi

	# unset array

	list=()

	return "${status}"
}

# delete ───────────────────────────────────────────────────────────────────────

# use to select file(s) for deletion from argument or array list
# removes selected file in directory

# usage:      frobulator.delete "[path]" "[file]" | "[array]"

frobulator.delete () {

	local status=0

	local path
	local item

	if [ "${#}" -eq 1 ]
	then
		path="${PWD}"

		if [[ "${#list[@]}" -gt 0 ]]
		then
			# ${1} - array

			list=("${@:1}")
		else
			item="${1}"

			list=()

			list+=("${item}")
		fi
	fi

	if [ "${#}" -eq 2 ]
	then
		path="${1}"

		if [[ "${#list[@]}" -gt 0 ]]
		then
			# ${2} - array

			list=("${@:2}")
		else
			item="${2}"

			list=()

			list+=("${item}")
		fi
	fi

	for item in "${list[@]}"
	do
		if [ ! -e "${path}/${item}" ]
		then
			frobulator.wrn "Nothing to delete" "[ ${path}/${item} ]"

			continue
		fi

		frobulator.rem "Deleting" "[ ${item} ]"

		# remove file

		rm --recursive --force "${path}/${item}"

		frobulator.track
	done

	# unset array

	list=()

	return "${status}"

}

# copy ─────────────────────────────────────────────────────────────────────────

# use to copy file(s) and/or diretories from argument or array list

# usage:      frobulator.copy "[source]" "[target]" "[file]" | "[array]"

frobulator.copy () {

	local status=0
	local source="${1}"
	local target="${2}"

	local file

	if [[ "${#list[@]}" -gt 0 ]]
	then
		# ${3} - array

		list=("${@:3}")
	else
		file="${3}"

		list=()

		list+=("${file}")
	fi

	if [ ! -d "${target}" ]
	then
		mkdir --parents "${target}"

		frobulator.track || return 1
	fi

	for file in "${list[@]}"
	do
		frobulator.lnk "Copying" "[ ${file} ]"

		cp --recursive --force "${source}/${file}" "${target}/${file}"

		frobulator.track
	done

	# unset array

	list=()

	return "${status}"
}

# move ─────────────────────────────────────────────────────────────────────────

# use to move file(s) and/or diretories from argument or array list

# usage:      frobulator.move "[source]" "[target]" "[file]" | "[array]"

frobulator.move () {

	local status=0
	local source="${1}"
	local target="${2}"

	local file

	if [[ "${#list[@]}" -gt 0 ]]
	then
		# ${3} - array

		list=("${@:3}")
	else
		file="${3}"

		list=()

		list+=("${file}")
	fi

	if [ ! -d "${target}" ]
	then
		mkdir --parents "${target}"

		frobulator.track || return 1
	fi

	for file in "${list[@]}"
	do
		if [ -z "${source}" ]
		then
			source="${PWD}"
		fi

		frobulator.lnk "Moving" "[ ${file} ]"

		mv "${source}/${file}" "${target}/${file}"

		frobulator.track || continue

		# set permissions

		frobulator.permissions public execute "${target}/${file}"

		frobulator.track
	done

	# unset array

	list=()

	return "${status}"

}

# link ─────────────────────────────────────────────────────────────────────────

# use to link file(s) and/or diretories from argument or array list

# usage:      frobulator.link "[source]" "[target]" "[item]" | "[array]"

frobulator.link () {

	local status=0
	local source="${1}"
	local target="${2}"

	local item
	local link
	local type

	# validation

	if [ -z "${source}" ] || [ -z "${target}" ]
	then
		frobulator.err "Missing link source or target"

		return 1
	fi

	if [ "${#}" -lt 3 ]
	then
		frobulator.err "Missing link item"

		return 1
	fi

	# target directory

	if [ ! -d "${target}" ]
	then
		mkdir --parents "${target}"

		frobulator.track || return 1
	fi

	# link single item

	if [ "${#}" -eq 3 ]
	then
		item="${3}"
		link="${3}"

		if [ -e "${source}/${item}" ]
		then
			if [ -d "${source}/${item}" ]
			then
				type="directory"
			fi

			if [ -f "${source}/${item}" ]
			then
				type="file"
			fi

			frobulator.lnk "Linking ${type}" "[ ${link} ]"

			ln -s -f "${source}/${item}" "${target}/${link}"

			if [ "${?}" -ne 0 ]
			then
				status=1
			else
				frobulator.ownership "${target}/${link}"

				frobulator.track
			fi
		fi
	fi

	# link renamed item

	if [ "${#}" -eq 4 ]
	then
		item="${3}"
		link="${4}"

		if [ -e "${source}/${item}" ]
		then
			if [ -d "${source}/${item}" ]
			then
				type="directory"
			fi

			if [ -f "${source}/${item}" ]
			then
				type="file"
			fi

			frobulator.lnk "Linking ${type}" "[ ${link} ]"

			ln -s -f "${source}/${item}" "${target}/${link}"

			if [ "${?}" -ne 0 ]
			then
				status=1
			else
				frobulator.ownership "${target}/${link}"

				frobulator.track
			fi
		fi
	fi

	# link array

	if [ "${#}" -gt 4 ]
	then
		list=("${@:3}")

		for item in "${list[@]}"
		do
			link="${item}"

			if [ -e "${source}/${item}" ]
			then
				if [ -d "${source}/${item}" ]
				then
					type="directory"
				fi

				if [ -f "${source}/${item}" ]
				then
					type="file"
				fi

				frobulator.lnk "Linking ${type}" "[ ${link} ]"

				ln -s -f "${source}/${item}" "${target}/${link}"

				frobulator.track || continue

				frobulator.ownership "${target}/${link}"

				frobulator.track
			fi
		done
	fi

	# unset array

	list=()

	return "${status}"

}

# image ────────────────────────────────────────────────────────────────────────

# use to display local or remote images directly in supported terminals
# supports local files, remote urls and stdin
# width defaults to terminal width
# preserves aspect ratio unless explicit height is specified

# image:
#              local image path
#              http/https image url

# width:
#              terminal cells or percentage
#              defaults to terminal width

# height:
#              terminal cells or percentage
#              disables automatic aspect ratio preservation

# usage:      frobulator.image "[image]"
#             frobulator.image "[image]" "[width]"
#             frobulator.image "[image]" "[width]" "[height]"

frobulator.image () {

	local status=0

	local image
	local width
	local height
	local ratio
	local input
	local encoding
	local inline
	local name
	local type
	local block
	local bytes
	local parts
	local part

	if [ "${#}" -eq 1 ]
	then
		image="${1}"

		width=${columns_terminal}

	elif [ "${#}" -eq 2 ]
	then
		image="${1}"
		width="${2}"

		ratio="1"

	elif [ "${#}" -eq 3 ]
	then
		image="${1}"
		width="${2}"
		height="${3}"

		ratio="0"
	fi

	if [ -z "${width}" ]
	then
		width=${columns_terminal}
	fi

	if [ -t 0 ]
	then
		# 'stdin' is a tty

		input="tty"
	else
		input="stdin"
	fi

	# verify image source:
	# url / local file

	if [[ "${image}" =~ ^(https?://)?[a-zA-Z0-9.-]+(\.[a-zA-Z]{2,})?(:[0-9]{1,5})?(/.*)?$ ]]
	then
		encoding="$(curl -s -L "${image}" | base64 -w 0)"

		frobulator.track

	elif [ -r "${image}" ]
	then
		encoding="$(cat "${image}" | base64 -w 0)"

		frobulator.track
	fi

	image_osc () {

		# osc - opening sequence characters
		# verify terminal multiplexer instance and type

		if [[ "${TERM}" == screen* || "${TERM}" == tmux* ]]
		then
			printf "\033Ptmux;\033\033]"
		else
			printf "\033]"
		fi
	}

	image_tsc () {

		# tsc - termination secquence characters
		# verify terminal multiplexer instance and type

		if [[ "${TERM}" == screen* ]] ||
		   [[ "${TERM}" == tmux*   ]]
		then
			printf "\a\033\\"
		else
			printf "\a"
		fi
	}

	image_parse () {

		# parameters

		image="${image}"

		input="${input}"

		encoding="${encoding}"

		inline="1"

		name="0"

		width="${width}"

		height="${height}"

		ratio="${ratio}"

		type=""

		block="1"

		echo

		# open sequence - begin transfer

		image_osc

		printf "1337;"

		if [[ "${block}" -eq 1 ]]
		then
			printf "File"
		else
			printf "MultipartFile"
		fi

		printf "=inline=%s" "${inline}"

		printf ";size=%d" "$(printf "%s" "${encoding}" | base64 -d -i | wc -c)"

		if [ -n "${image}" ]
		then
			printf ";name=%s" "$(printf "%s" "${image}" | base64 -w 0)"
		fi

		if [ -n "${width}" ]
		then
			printf ";width=%s" "${width}"
		fi

		if [ -n "${height}" ]
		then
			printf ";height=%s" "${height}"
		fi

		if [ -n "${ratio}" ]
		then
			printf ";preserveAspectRatio=%s" "${ratio}"
		fi

		#[ -n "${type}" ] && printf ";type=%s" "${type}"

		if [[ "${block}" -eq 1 ]]
		then
			printf ":%s" "${encoding}"

			image_tsc
		else
			image_tsc

			# split into 512-byte parts:
			# optimizes parsing through terminal multiplexer

			bytes=512

			mapfile -t parts < <(printf "%s" "${encoding}" | fold -w "${bytes}")

			# load byte stream

			for part in "${parts[@]}"
			do
				image_osc

				printf '1337;FilePart=%s' "${part}"

				image_tsc
			done

			# terminate sequence

			image_osc

			printf '1337;FileEnd'

			image_tsc
		fi

		echo

		if [ "${name}" = "1" ]
		then
			echo "Image: ${image}"
			echo
		fi
	}

	image_print () {

		if [ "${input}" = "stdin" ]
		then
			image=""
			inline="1"
			encoding=$(cat | base64 -w 0)

		elif [ "${input}" = "tty" ]
		then
			inline="1"
		fi

		image_parse "${image}" "${inline}" "${encoding}" "${name}" "${width}" "${height}" "${ratio}" "${type}" "${block}"
	}

	if [ -z "${image}" ]
	then
		frobulator.err "No image supplied"

		return 1
	fi

	image_print

	frobulator.track

	return "${status}"

}

# http ─────────────────────────────────────────────────────────────────────────

# use to validate http status code prior to download / upload operations
# use for url addresses [url] and data download validations [content]

# usage:      frobulator.http "[url]"				type: url		[default]

#             frobulator.http "[url]" "[content]"	type: content

frobulator.http () {

	local status=0
	local code_http="%{http_code}\n"
	local url="${1}"
	local data="${2}"

	if [ "${#}" -eq 1 ]
	then
		status_url="$(
			curl						\
				--silent				\
				--output "${sink}"		\
				--write-out "${code_http}"	\
				"${url}"
		)"

		frobulator.track

	elif [ "${#}" -eq 2 ]
	then
		status_url="$(
			curl							\
				--silent					\
				--output "${sink}"			\
				--write-out "${code_http}"		\
				--location					\
				"${url}/${data}"				\
			| tail -n 1					\
			| cut -d ':' -f 1
		)"

		frobulator.track
	else
		status=1
	fi

	return "${status}"

}

# status ───────────────────────────────────────────────────────────────────────

# use to parse and validate HTTP status responses and manage download actions
# use in tandem with frobulator.http

# usage:      frobulator.http "[url]"
#             frobulator.status

frobulator.status () {

	local status=0

	local label_status_url

	frobulator.fwd "Validating URL${marker_elp}"

	if [[ "${status_url}" = [1][0-9][0-9] ]]
	then
		label_status_url="information"

		frobulator.inf "Download status" "[ ${label_status_url}${marker_spc}${marker_hnt}${marker_spc}${status_url} ]"

		proceed=1

	elif [[ "${status_url}" = [2][0-9][0-9] ]]
	then
		label_status_url="success"

		frobulator.scs "Download status" "[ ${label_status_url}${marker_spc}${marker_hnt}${marker_spc}${status_url} ]"

		proceed=1

	elif [[ "${status_url}" = [3][0-9][0-9] ]]
	then
		label_status_url="redirect"

		frobulator.wrn "Download status" "[ ${label_status_url}${marker_spc}${marker_hnt}${marker_spc}${status_url} ]"

		proceed=1

	elif [[ "${status_url}" = [4][0-9][0-9] ]]
	then
		label_status_url="error"

		frobulator.err "Download status" "[ ${label_status_url}${marker_spc}${marker_hnt}${marker_spc}${status_url} ]"

		reason="client"

		proceed=0

		status=1

	elif [[ "${status_url}" = [5][0-9][0-9] ]]
	then
		label_status_url="error"

		frobulator.err "Download status" "[ ${label_status_url}${marker_spc}${marker_hnt}${marker_spc}${status_url} ]"

		reason="server"

		proceed=0

		status=1
	else
		label_status_url="unknown"

		frobulator.err "Download status" "[ ${label_status_url}${marker_spc}${marker_hnt}${marker_spc}${status_url} ]"

		reason="response"

		proceed=0

		status=1
	fi

	return "${status}"

}

# repository ───────────────────────────────────────────────────────────────────

# use to list file names at the top level of a github repository:
# names starting with the optional prefix - stored in frobulator_return

# usage:      frobulator.repository "[owner/repository]" "[prefix]"

frobulator.repository () {

	local status=0
	local name_repository="${1}"
	local prefix_repository="${2}"

	local url_repository
	local items_repository
	local item_repository

	frobulator_return=()

	# validation

	if [ -z "${name_repository}" ]
	then
		frobulator.err "Repository listing failure - missing repository" "[ owner/repository ]"

		return 1
	fi

	# github contents listing - all items as one json text - one name field per item

	url_repository="https://api.github.com/repos/${name_repository}/contents"

	items_repository="$(
		curl									\
			--silent							\
			--location							\
			--connect-timeout 30				\
												"${url_repository}" 2> "${sink}"
	)"

	frobulator.track

	# names starting with prefix

	while IFS= read -r item_repository
	do
		if [[ "${item_repository}" == "${prefix_repository}"* ]]
		then
			frobulator_return+=("${item_repository}")
		fi
	done < <(
		grep -o '"name": *"[^"]*"' <<< "${items_repository}"	|
			cut -d '"' -f 4
	)

	if [ "${#frobulator_return[@]}" -eq 0 ]
	then
		frobulator.err "Repository listing empty" "[ ${name_repository} // ${prefix_repository:-all} ]"

		return 1
	fi

	return "${status}"

}

# download ─────────────────────────────────────────────────────────────────────

# use to download file(s) from argument or array list
# each file is reported with the http status code of its own download
# a file is only written when the download succeeds (2xx)

# usage:      frobulator.download "[url]"                    "[directory]"             "[item]" | "[array]"
#             frobulator.download "[url]"/"[item]"           "[directory]"/"[item]"
#             frobulator.download "[url]"/"[item]"           "[directory]"
#             frobulator.download "[url]"    "[source item]" "[directory]"             "[item]"

#             a single item is fetched from "[url]" itself when the url already ends with
#             the item or a file name (extension) - otherwise from "[url]"/"[item]"

frobulator.download () {

	local status=0
	local url="${1}"

	local path_url
	local segment_url
	local directory_download
	local item_download
	local index_download
	local source_download
	local label_download
	local target_download
	local file_download_partial
	local code_download
	local url_download_display

	local -a list_download=()
	local -a sources_download=()

	# validation

	if [ -z "${url}" ] || [ -z "${2}" ]
	then
		frobulator.err "Download failure - missing url or directory" "[ download${marker_spc}${marker_hnt}${marker_spc}000 ]"

		return 1
	fi

	# url segments: path after the host - last path segment

	path_url="${url#*://}"
	path_url="${path_url#*/}"
	segment_url="${url%/}"
	segment_url="${segment_url##*/}"

	if [ "${path_url}" = "${url#*://}" ]
	then
		unset path_url
	fi

	# call forms

	if [ "${#}" -eq 2 ]
	then
		# url is the file: target is a directory or the file path

		if [ -d "${2}" ] || [[ "${2}" = */ ]]
		then
			directory_download="${2%/}"
			list_download=("${segment_url}")
		else
			directory_download="$(dirname -- "${2}")"
			list_download=("${2##*/}")
		fi

		sources_download=("${url}")

	elif [ "${#}" -eq 4 ] && [[ "${2}" != */* ]] && [[ "${3}" = */* || -d "${3}" ]]
	then
		# source item saved under a different name

		directory_download="${3}"
		list_download=("${4}")
		sources_download=("${url%/}/${2}")
	else
		# items from the url into the directory

		directory_download="${2}"
		list_download=("${@:3}")

		for item_download in "${list_download[@]}"
		do
			if [ "${#list_download[@]}" -eq 1 ] && [ -n "${path_url}" ] &&
			   [[ "${segment_url}" = "${item_download}" || "${segment_url}" = *.* ]]
			then
				sources_download+=("${url}")
			else
				sources_download+=("${url%/}/${item_download}")
			fi
		done
	fi

	if [ "${#list_download[@]}" -eq 0 ]
	then
		frobulator.err "Download failure - no item" "[ download${marker_spc}${marker_hnt}${marker_spc}000 ]"

		return 1
	fi

	# directory

	if [ ! -d "${directory_download}" ]
	then
		mkdir --parents "${directory_download}" 2> "${sink}"

		frobulator.fail "Download failure - directory" "[ '${directory_download}'${marker_spc}${marker_hnt}${marker_spc}000 ]" || return
	fi

	# download items

	for index_download in "${!list_download[@]}"
	do
		item_download="${list_download[${index_download}]}"
		source_download="${sources_download[${index_download}]}"
		label_download="'${item_download}'"
		target_download="${directory_download}/${item_download}"

		# shown url always carries a protocol

		if [[ "${source_download}" = *://* ]]
		then
			url_download_display="${source_download}"
		else
			url_download_display="${marker_hts}${source_download}"
		fi

		if [ -z "${item_download}" ]
		then
			frobulator.err "Download failure - no item" "[ download${marker_spc}${marker_hnt}${marker_spc}000 ]"

			status=1

			continue
		fi

		# download to a partial file beside the target - kept only on success

		file_download_partial="$(mktemp "${directory_download}/.${item_download}.XXXXXX" 2> "${sink}")"

		if [ -z "${file_download_partial}" ]
		then
			frobulator.err "Download failure - file" "[ ${label_download}${marker_spc}${marker_hnt}${marker_spc}000 ]"
			frobulator.nul "Unable to write to '${directory_download}'."

			status=1

			continue
		fi

		curl								\
			--silent						\
			--location						\
			--connect-timeout 30			\
			--output "${file_download_partial}"	\
			--write-out "%{http_code}"		\
			"${source_download}" > "${file_download_partial}.status" &

		frobulator.progress "download" "[ ${label_download} ]"

		code_download="$(< "${file_download_partial}.status")"

		rm -f "${file_download_partial}.status"

		# report by http status code of the download itself

		if [[ "${code_download}" =~ ^2[0-9][0-9]$ ]]
		then
			mv -f "${file_download_partial}" "${target_download}"

			frobulator.permissions public execute "${target_download}" > "${sink}"

			frobulator.scs "Download success - file" "[ ${label_download}${marker_spc}${marker_hnt}${marker_spc}${code_download} ]"

		elif [ -z "${code_download}" ] || [ "${code_download}" = "000" ]
		then
			# no response: curl reports 000

			rm -f "${file_download_partial}"

			frobulator.err "Server unreachable - file" "[ ${label_download}${marker_spc}${marker_hnt}${marker_spc}000 ]"
			frobulator.nul "'${url_download_display}'"

			status=1
		else
			rm -f "${file_download_partial}"

			frobulator.err "Download failure - file" "[ ${label_download}${marker_spc}${marker_hnt}${marker_spc}${code_download} ]"
			frobulator.nul "'${url_download_display}'"

			status=1
		fi
	done

	return "${status}"
}

# upload ───────────────────────────────────────────────────────────────────────

# use to upload data or file(s) with url from argument or array list
# each item is sent as its own request and reported with its http status code

# usage:      frobulator.upload "[request]" "[url]" "[item]" | "[array]"

#             item as json data {...} / [...] - form data - or path to item prefixed with @
#             array as array of data or items

frobulator.upload () {

	local status=0
	local request="${1}"
	local url="${2}"

	local item_upload
	local file_upload
	local type_upload
	local name_upload
	local label_upload
	local file_upload_response
	local code_upload

	local -a list_upload=("${@:3}")
	local -a command_upload=()

	# validation

	if [ -z "${request}" ] || [ -z "${url}" ]
	then
		frobulator.err "Upload failure - missing request or url" "[ upload${marker_spc}${marker_hnt}${marker_spc}000 ]"

		return 1
	fi

	if [ "${#list_upload[@]}" -eq 0 ]
	then
		frobulator.err "Upload failure - no data" "[ ${request}${marker_spc}${marker_hnt}${marker_spc}000 ]"

		return 1
	fi

	file_upload_response="$(mktemp)"

	# upload items

	for item_upload in "${list_upload[@]}"
	do
		if [ -z "${item_upload}" ]
		then
			frobulator.err "Upload failure - no data" "[ ${request}${marker_spc}${marker_hnt}${marker_spc}000 ]"

			status=1

			continue
		fi

		# item type and name

		if [[ "${item_upload}" =~ ^\{.*\}$ ]] || [[ "${item_upload}" =~ ^\[.*\]$ ]]
		then
			type_upload="json data"
			name_upload="${item_upload//${NLN}/${marker_spc}}"

		elif [[ "${item_upload}" = @* ]]
		then
			file_upload="${item_upload#@}"

			type_upload="file"
			name_upload="${file_upload##*/}"
		else
			type_upload="form data"
			name_upload="${item_upload//${NLN}/${marker_spc}}"
		fi

		label_upload="'${name_upload}'"

		command_upload=(
			curl
			--silent
			--location
			--connect-timeout 30
			--output "${sink}"
			--write-out "%{http_code}"
			--request "${request}"
		)

		if [ "${type_upload}" = "json data" ]
		then
			command_upload+=(
				--header "Content-Type: application/json"
				--data "${item_upload}"
			)

		elif [ "${type_upload}" = "file" ]
		then
			if [ ! -s "${file_upload}" ]
			then
				frobulator.err "Upload failure - ${type_upload}" "[ ${label_upload}${marker_spc}${marker_hnt}${marker_spc}000 ]"
				frobulator.nul "File is empty or does not exist."

				status=1

				continue
			fi

			command_upload+=(
				--form "file=@${file_upload}"
			)
		else
			command_upload+=(
				--header "Content-Type: application/x-www-form-urlencoded"
				--data "${item_upload}"
			)
		fi

		command_upload+=("${url}")

		"${command_upload[@]}" > "${file_upload_response}" &

		frobulator.progress "upload" "[ ${label_upload} ]"

		code_upload="$(< "${file_upload_response}")"

		# report by http status code of the upload itself

		if [[ "${code_upload}" =~ ^2[0-9][0-9]$ ]]
		then
			frobulator.scs "Upload success - ${type_upload}" "[ ${label_upload}${marker_spc}${marker_hnt}${marker_spc}${code_upload} ]"

		elif [ -z "${code_upload}" ] || [ "${code_upload}" = "000" ]
		then
			# no response: curl reports 000
			frobulator.err "Server unreachable - ${type_upload}" "[ ${label_upload}${marker_spc}${marker_hnt}${marker_spc}000 ]"
			frobulator.nul "'${url}'"

			status=1
		else
			frobulator.err "Upload failure - ${type_upload}" "[ ${label_upload}${marker_spc}${marker_hnt}${marker_spc}${code_upload} ]"

			status=1
		fi
	done

	rm -f "${file_upload_response}"

	return "${status}"
}

# silence ──────────────────────────────────────────────────────────────────────

# use to wrap command execution and redirect all output to null sink
# provides fully silent execution

# usage:      frobulator.silence "[command]"

frobulator.silence () {

	local status=0
	local command="${*}"

	"${SHELL}" -c "${command}" >> "${sink}" 2>&1

	frobulator.track

	return "${status}"

}

# log ──────────────────────────────────────────────────────────────────────────

# use to wrap command and redirect all output to "${script}"-"${stamp}".log file
# provides fully silent execution

# usage:      frobulator.log "[command]"

frobulator.log () {

	local status=0
	local command="${*}"

	local directory_log
	local log

	if [ -z "${SUDO:-${HOME}}" ]
	then
		directory_log="${PREFIX}/var/log"
	else
		if [ ! -d "${HOME}/.local/var/log" ]
		then
			mkdir --parents "${HOME}/.local/var/log"

			frobulator.track || return 1
		fi

		directory_log="${HOME}/.local/var/log"
	fi

	if [ -z "${script}" ]
	then
		script="$(basename -- "${BASH_SOURCE[0]}")"

		frobulator.track || return 1
	fi

	script="${script##*/}"

	log="${directory_log}/${script}-${stamp}.log"

	"${SHELL}" -c "${command}" >> "${log}" 2>&1

	frobulator.track

	return "${status}"

}

# password ─────────────────────────────────────────────────────────────────────

# use to obfuscate password input with custom mask character

# usage:      frobulator.password

frobulator.password () {

	local status=0
	local mask_character="•"
	local mask=""

	local character_input

	password=""

	while read -p "${mask}" -r -s -n 1 character_input
	do
		# enter / accept password

		if [[ "${character_input}" == $'\0' ]]
		then
			# break on 'NUL'

			break
		fi

		# handle backspace / delete character input

		if [[ "${character_input}" == $'\177' ]]
		then
			# remove input on 'BACKSPACE'/'DEL'

			if [ -n "${password}" ]
			then
				mask=$'\b \b'

				password="${password%?}"
			else
				mask=""
			fi
		else
			# set character mask

			mask="${mask_character}"

			# append user input and form password

			password+="${character_input}"
		fi
	done

	frobulator.track

	input="${password}"

	# normalize line spacing:
	# additional 'echo' required due to 'read'

	echo

	return "${status}"

	}

# input ────────────────────────────────────────────────────────────────────────

# use to capture user input

# usage:      frobulator.input "[array]"

frobulator.input () {

	local status=0

	local prompt
	local label
	local input

	list=("${@}")

	for prompt in "${list[@]}"
	do
		label="${prompt^}"
		prompt="$(echo "${label}" | sed 's/_/ /'):"

		frobulator.ipt "${prompt}"

		if [[ "${prompt}" = *password* ]]
		then
			frobulator.password

			frobulator.track || continue

			input="${password}"
		else
			read -r input

			frobulator.track || continue
		fi

		# prevent empty input

		while true
		do
			if [ -z "${input}" ]
			then
				echo
				frobulator.err "${prompt%:} cannot be empty"

				prompt="$(echo "${label}" | sed 's/_/ /'):"

				frobulator.ipt "${prompt}"

				if [[ "${prompt}" = *password* ]]
				then
					frobulator.password

					frobulator.track || break

					input="${password}"
				else
					read -r input

					frobulator.track || break
				fi
			else
				break
			fi
		done

		label="${label,}"

		frobulator_return+=("${label}=${input}")
	done

	# unset array

	list=()

	# normalize line spacing:
	# additional 'echo' required due to 'read'

	echo

	return "${status}"

}

# clean ────────────────────────────────────────────────────────────────────────

# use to run package and installer post-install cleanup

# usage:      frobulator.clean

# clean ────────────────────────────────────────────────────────────────────────

frobulator.clean () {

	local status=0
	local command_autoremove="apt-get autoremove"
	local command_autoclean="apt-get autoclean"
	local command_clean="apt-get clean"

	frobulator.log "${command_autoremove}" &

	frobulator.process "Flushing package(s)"

	frobulator.track

	frobulator.log "${command_autoclean}" &

	frobulator.progress "Autoclean"

	frobulator.track

	frobulator.log "${command_clean}" &

	frobulator.progress "Clean"

	frobulator.track

	# fix dpkg lock and errors
	# remove post-install logs to prevent package configuration errors

	if [ -d "${PREFIX}"/var/lib/dpkg/info ]
	then
		rm																\
			--recursive													\
			--force			"${PREFIX}"/var/lib/dpkg/info/*.postinst	\
																		>> "${sink}" 2>&1

		frobulator.track
	fi

	return "${status}"

}

