# failsafe ─────────────────────────────────────────────────────────────────────

# use to install package(s) and update system
# helps avoid 'ignore' or 'not found' errors returned by package manager
# useful as failsafe to fetch all up-to-date content before batch installs

# usage:      frobulator.failsafe "[package]" | "[array]"

frobulator.failsafe () {

	local status=0
	local command_update="apt-get --assume-yes update"
	local command_upgrade="apt-get --assume-yes dist-upgrade"
	local command_install="apt-get --assume-yes install"

	local package

	failsafe_intent () {

		# run failsafe package and repository update
		# mitigate general deployment setup issues
		# mitigate skipped packages on install

		yes | apt update > "${sink}" 2>&1

		yes | apt full-upgrade > "${sink}" 2>&1
	}

	export DEBIAN_FRONTEND=noninteractive

	if [[ "${#list[@]}" -gt 0 ]]
	then
		# ${1} - array

		list=("${@:1}")
	else
		package="${1}"

		list=()

		list+=("${package}")
	fi

	failsafe_intent &

	frobulator.process "Please wait"

	frobulator.track

	frobulator.fwd "Loading${marker_elp}"

	for package in "${list[@]}"
	do
		frobulator.log "${command_update}"

		frobulator.track

		frobulator.log "${command_upgrade}"

		frobulator.track

		frobulator.log "${command_install} ${package}"

		frobulator.track
	done

	# unset array

	list=()

	return "${status}"

}

# install ──────────────────────────────────────────────────────────────────────

# use to install package(s) from argument or array list

# usage:      frobulator.install "[package]" | "[array]"

frobulator.install () {

	local status=0
	local command_install="apt-get --assume-yes install"

	local package
	local filter_query
	local text_packages

	export DEBIAN_FRONTEND=noninteractive

	if [[ "${#list[@]}" -gt 0 ]]
	then
		# ${1} - array

		list=("${@:1}")
	else
		package="${1}"

		list=()

		list+=("${package}")
	fi

	# package names quoted - one header line

	text_packages="$(printf "'%s' " "${list[@]}")"

	frobulator.inf "Installing package(s)" "[ ${text_packages% } ]"

	for package in "${list[@]}"
	do
		if [[ "${package}" = *.deb ]]
		then
			frobulator.msg "Local package(s) selected"

			frobulator.log "${command_install} ${package}" &

			frobulator.progress "install"

			frobulator.track
		else
			filter_query="$(apt search "${package}" 2> "${sink}" | grep installed | cut -d '/' -f 1 | grep ^"${package}"$)"

			if [[ -z "${filter_query}" ]]
			then
				# absence already reported by frobulator.require

				if [ "${frobulator_absence_reported}" != "true" ]
				then
					frobulator.wrn "Absent on system" "[ '${package}' ]"
				fi

				frobulator.log "${command_install} ${package}" &

				frobulator.progress "install"

				frobulator.track
			else
				frobulator.scs "Present on system" "[ '${package}' ]"

				frobulator.fwd "Continuing${marker_elp}"
			fi
		fi
	done

	# unset array

	list=()

	return "${status}"
}

# require ──────────────────────────────────────────────────────────────────────

# use to install required package(s) from argument or array list
# use to search and validate required package dependencies for operations

# usage:      frobulator.require "[package]" | "[array]"

frobulator.require () {

	local status=0
	local list_requirements_missing=false

	# absence reported here - frobulator.install does not repeat it

	local frobulator_absence_reported="true"

	local command
	local command_path
	local status_package
	local packages
	local package_query
	local content_query
	local line_query
	local command_query
	local directory_system_binary

	local -a list_requirements=("${@}")
	local -a filter_query=()
	local -a list_install=()

	export DEBIAN_FRONTEND=noninteractive

	# empty list: nothing to require

	if [ "${#list_requirements[@]}" -eq 0 ]
	then
		frobulator.stp "No requirement(s) specified"

		frobulator.fwd "Continuing${marker_elp}"

		return "${status}"
	fi

	# apt-file is only needed to find the package providing a missing command

	for command in "${list_requirements[@]}"
	do
		# command path - empty if not installed

		command_path="$(command -v "${command}")"

		# package install state - empty if unknown to dpkg

		status_package="$(dpkg-query --show --showformat='${Status}' "${command}" 2> "${sink}")"

		if [[ "${command}" != *'*'* ]] && [ -z "${command_path}" ] && [[ "${status_package}" != *"ok installed"* ]]
		then
			list_requirements_missing=true

			break
		fi
	done

	if [ "${list_requirements_missing}" = true ]
	then
		frobulator.failsafe apt-file

		frobulator.track

		frobulator.log "apt-file update"

		frobulator.track
	fi

	frobulator.fwd "Validating requirement(s)${marker_elp}"

	for command in "${list_requirements[@]}"
	do
		# command path - empty if not installed

		command_path="$(command -v "${command}")"

		# package install state - empty if unknown to dpkg

		status_package="$(dpkg-query --show --showformat='${Status}' "${command}" 2> "${sink}")"

		if [[ "${command}" == *'*'* ]]
		then
			frobulator.fwd "Expanding package selection query" "[ '${command}' ]"

			packages="$(apt-cache pkgnames)"

			frobulator.track || continue

			while IFS= read -r package_query
			do
				if [[ "${package_query}" == ${command} ]]
				then
					frobulator.add "Package selection found" "[ '${package_query}' ]"

					list_install+=("${package_query}")
				fi
			done <<< "${packages}"

			echo

			if [[ "${#list_install[@]}" -ge 1 ]]
			then
				frobulator.install "${list_install[@]}"

				frobulator.track

				list_install=()
			else
				frobulator.err "Package selection not found" "[ '${command}' ]"

				status=1
			fi

		elif [ -z "${command_path}" ] && [[ "${status_package}" == *"ok installed"* ]]
		then
			frobulator.scs "Package provision already present on system" "[ '${command}' ]"

		elif [ -z "${command_path}" ]
		then
			frobulator.wrn "Absent on system" "[ '${command}' ]"

			frobulator.fwd "Probing${marker_elp}"

			IFS="${marker_spc}"

			filter_query=( $(apt-file search "${command}" | sed -e "s/${marker_spc}//" | grep ^"${command}": | grep /"${command}"$) )

			unset IFS

			while IFS= read -r line_query
			do
				IFS=':'

				read -r package_query content_query <<< "${line_query}"

				unset IFS

				directory_system_binary=/usr/bin

				command_query="${directory_system_binary}/${command}"

				if [[ "${package_query}" == "${command}" ]] && [[ "${content_query}" == "${command_query}" ]]
				then
					frobulator.scs "Command provision found as package" "[ '${package_query}' ]"

					list_install+=("${package_query}")

					break

				elif [[ "${package_query}" == "${command}" ]] && [[ "${content_query}" =~ "${command}"$ ]]
				then
					frobulator.scs "Command provision found as reverse match" "[ '${package_query}' ]"

					list_install+=("${package_query}")

					break

				elif [[ "${line_query}" = "" ]]
				then
					IFS="${marker_spc}"

					filter_query=( $(apt-file search "${command}" | sed -e "s/${marker_spc}//" | grep ^"${command}":) )

					unset IFS

					while IFS= read -r line_query
					do
						IFS=':'

						read -r package_query content_query <<< "${line_query}"

						unset IFS

						if [[ "${package_query}" == "${command}" ]] && [[ ! "${content_query}" =~ "${command}"$ ]]
						then
							frobulator.scs "Command provision found as meta package" "[ '${package_query}' ]"

							list_install+=("${package_query}")

							break
						else
							frobulator.err "Command provision not found" "[ '${command}' ]"
						fi
					done <<< "${filter_query[@]}"
				fi
			done <<< "${filter_query[@]}"

			if [[ "${#list_install[@]}" -ge 1 ]]
			then
				frobulator.install "${list_install[@]}"

				frobulator.track

				list_install=()
			else
				status=1
			fi
		else
			frobulator.scs "Command provision already present on system" "[ '${command}' ]"
		fi
	done

	return "${status}"

}

