#!/bin/bash

# dependencies ─────────────────────────────────────────────────────────────────

# superuser ────────────────────────────────────────────────────────────────────

# script ───────────────────────────────────────────────────────────────────────

# version ──────────────────────────────────────────────────────────────────────

# read as text by bootstrap

update="2026-10-10-1231"

version="${update}"

# variables ────────────────────────────────────────────────────────────────────

stamp=$(date +"%m-%d-%Y-%H-%M-%S")

# defaults ─────────────────────────────────────────────────────────────────────

self="${BASH_SOURCE[0]}"

# usage ────────────────────────────────────────────────────────────────────────

# executed directly: handle options - install at end of file

directory_install="${HOME}"/.local/bin

if [[ "${self}" = "${0}" ]]
then
	script="$(basename -- "${self}")"

	while (( $# ))
	do
		case "${1}"
		in
			-i|--install)
				option="install"
			;;

			-c|--critter)
				option="critter"

				arguments_critter=("${@:2}")

				break

				# note:
				# easter egg - not listed in help or readme
				# remaining arguments go to the critter

			;;

			-h|--help)
				echo
				echo -e "Usage: ./${script} -i | -h"
				echo
				echo -e "Options:"
				echo
				echo -e "-i, --install    Run [i]nstallation of ${script} to ${directory_install}."
				echo
				echo -e "-h, --help       Show [h]elp and usage information."
				echo
				echo -e "'${script}'      [ Version // ${version} ]"
				echo

				exit
			;;

			"")
				# handle empty argument:
				# use default values specified in script

				:
			;;

			*)
				echo
				echo -e "Usage: ./${script} -i | -h"
				echo
				echo -e "Unknown option: '${script} ${1}':"
				echo -e "Type './${script} -h' for help and usage information."
				echo

				exit 1

			;;

			esac

		shift

	done

	# default to install

	if [ -z "${option}" ]
	then
		option="install"
	fi
fi

# requirements ─────────────────────────────────────────────────────────────────

# provide system shell

if [ -z "${SHELL}" ]
then
	# bash at its usual location - empty if absent

	command_bash="$(command -v /bin/bash)"

	if [ -n "${command_bash}" ]
	then
		SHELL="${command_bash}"
	else
		SHELL=$(command -v /usr/bin/bash)
	fi
else
	SHELL="${SHELL}"
fi

# detection variables are not kept in the shell

unset command_bash

# provide null sink for argument / error / output silencing

if [ -e /dev/null ]
then
	sink="/dev/null"
fi

# follow terminal width

columns_terminal_minimum=80

columns_terminal="${columns_terminal_minimum}"
columns_terminal_actual="${columns_terminal_minimum}"

# rows printed by line markers since frobulator loaded - escalation clears them

lines_printed_terminal=0

frobulator.columns () {

	local columns

	columns=$(tput cols 2> "${sink}")

	if [[ -t 1 ]] && [[ "${columns}" =~ ^[0-9]+$ ]] && [ "${columns}" -gt "${columns_terminal_minimum}" ]
	then
		columns_terminal="${columns}"
	else
		columns_terminal="${columns_terminal_minimum}"
	fi

	# real width for wrapped line counts - may be under the minimum

	if [[ -t 1 ]] && [[ "${columns}" =~ ^[1-9][0-9]*$ ]]
	then
		columns_terminal_actual="${columns}"
	else
		columns_terminal_actual="${columns_terminal}"
	fi
}

frobulator.columns

trap 'frobulator.columns' WINCH

# provide fallback for non 'root' assessments

self="${0}"

if [ -z "${script}" ]
then
	script="${self}"
fi

# package manager ──────────────────────────────────────────────────────────────

# detect package manager: each candidate path - empty if absent

manager_package_apt="$(command -v apt)"
manager_package_dnf="$(command -v dnf)"
manager_package_yum="$(command -v yum)"
manager_package_pip="$(command -v pip)"
manager_package_pipx="$(command -v pipx)"

if [ -n "${manager_package_apt}" ]
then
	manager_package="apt"

elif [ -n "${manager_package_dnf}" ]
then
	manager_package="dnf"

elif [ -n "${manager_package_yum}" ]
then
	manager_package="yum"

elif [ -n "${manager_package_pip}" ]
then
	manager_package="pip"

elif [ -n "${manager_package_pipx}" ]
then
	manager_package="pipx"
fi

# detection variables are not kept in the shell

unset manager_package_apt manager_package_dnf manager_package_yum manager_package_pip manager_package_pipx

