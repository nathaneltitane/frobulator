#
# command:    frobulator.num lime "[number]" "[string]"
# result:     [ n ] string - number and string in the palette color

frobulator.num () {

	local color_number="${teal}"

	local color_prompt
	local number

	local before="[${marker_spc}${marker_spc}"
	local after="${marker_spc}${marker_spc}]"

	# optional palette color first - number and string in that color - added colors included

	if [[ "$(printf ' %s ' "${colors_selection[@]%%=*}")" == *" ${1} "* ]]
	then
		color_number="${!1}"
		color_prompt="${!1}"

		shift
	fi

	number="${1}"

	shift

	frobulator.pmt "${@}"

	prompt="${prompt_string[@]}"

	echo -e "${before}${color_number}${number}${reset}${after}${marker_spc}${color_prompt}${prompt}${color_prompt:+${reset}}"

	frobulator.brk
}

